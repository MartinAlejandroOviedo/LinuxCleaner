#!/usr/bin/env bash
#
# clean - Limpieza de archivos temporales y residuales en Debian
#
# Uso:
#   clean [opciones]
#
# Opciones:
#   -a, --all       Ejecuta todas las tareas de limpieza (sistema + unidades)
#   -t, --temp      Limpia archivos temporales (/tmp, /var/tmp)
#   -c, --cache     Limpia la caché de APT y paquetes huérfanos
#   -l, --logs      Vacía/rota los logs del sistema (journal + /var/log)
#   -T, --trash     Vacía la papelera del usuario
#   -m, --thumbs    Limpia miniaturas y cachés de usuario
#   -b, --browsers  Limpia la caché de los navegadores (Firefox, Chrome, etc.)
#   -r, --ram       Libera page/buffer cache y swap
#   -d, --drives    Limpia papeleras y temporales de unidades montadas
#   -u, --user-cache Limpia ~/.cache/ completo y ~/.nv/ (NVIDIA)
#   -D, --dev       Limpia cachés de desarrollo (.gradle, .npm, .cargo, pip, etc.)
#   -j, --junk      Busca y borra archivos basura seguros (*.swp, *.pyc, .DS_Store, etc.)
#   -w, --wine      Limpia temporales y cachés de Wine (~/.wine)
#   -M, --media     Limpia cachés multimedia (VLC, MPV, GStreamer, GIMP, etc.)
#   -g, --games     Limpia cachés de launchers de juegos (Steam, Lutris, Heroic, etc.)
#   -V, --venv      Limpia entornos virtuales Python huérfanos y pip cache vieja
#   -K, --apt-check Revisa fuentes APT con errores, duplicados y claves faltantes
#   -s, --status    Muestra el uso de disco antes y después de la limpieza
#   -n, --dry-run   Muestra lo que se haría sin borrar nada
#   -I, --interactive TUI con progreso y confirmación antes de borrar
#   -y, --yes       Omite la confirmación interactiva (útil con --all)
#   -h, --help      Muestra esta ayuda
#
set -uo pipefail

DRY_RUN=0
INTERACTIVE=0
NO_CONFIRM=0
HISTFILE="${XDG_CACHE_HOME:-$HOME/.cache}/clean-history.log"
SUDO=""
TUI_TASK_CURRENT=0
TUI_TASK_TOTAL=0

# ------------------------------------------------------------------ helpers
c_info()  { printf '\033[1;34m[*]\033[0m %s\n' "$1"; }
c_ok()    { printf '\033[1;32m[+]\033[0m %s\n' "$1"; }
c_warn()  { printf '\033[1;33m[!]\033[0m %s\n' "$1"; }
c_err()   { printf '\033[1;31m[x]\033[0m %s\n' "$1" >&2; }

term_width() {
  local cols
  cols=$(tput cols 2>/dev/null || printf '80')
  [ "$cols" -lt 60 ] && cols=60
  printf '%s\n' "$cols"
}

tui_line() {
  local cols
  cols=$(term_width)
  printf '  \033[38;5;45m'
  printf '%*s' "$((cols - 4))" '' | tr ' ' '='
  printf '\033[0m\n'
}

tui_header() {
  local title="$1"
  printf '\n'
  tui_line
  printf '  \033[1;38;5;45m%s\033[0m\n' "$title"
  tui_line
}

tui_progress() {
  local phase="$1" current="$2" total="$3" detail="$4"
  [ "$total" -gt 0 ] || total=1
  [ "$current" -gt "$total" ] && current="$total"

  local width=28
  local percent=$(( current * 100 / total ))
  local filled=$(( current * width / total ))
  local empty=$(( width - filled ))
  local bar_done bar_empty
  bar_done=$(printf '%*s' "$filled" '' | tr ' ' '#')
  bar_empty=$(printf '%*s' "$empty" '' | tr ' ' '.')

  printf '  \033[1;36m%-8s\033[0m [%s%s] \033[1;37m%3d%%\033[0m  %s\n' "$phase" "$bar_done" "$bar_empty" "$percent" "$detail"
}

tui_scan_step() {
  local current="$1" total="$2" detail="$3"
  tui_progress "Escaneo" "$current" "$total" "$detail"
}

tui_run_task() {
  local label="$1" detail="$2" fn="$3"
  TUI_TASK_CURRENT=$((TUI_TASK_CURRENT + 1))
  tui_progress "Borrado" "$TUI_TASK_CURRENT" "$TUI_TASK_TOTAL" "$detail"
  "$fn"
  c_ok "Módulo completado: $label"
}

# Cabecera con barra azul para secciones
c_section() {
  local label="$1"
  local n=${#label}
  local fill=$(( (50 - n - 2) / 2 ))
  local remain=$(( 50 - n - fill - 2 ))
  printf '\n \033[1;37;44m%*s\033[22;0m' "$fill" ""
  printf '\033[1;37;44m %s \033[22;0m' "$label"
  printf '\033[1;37;44m%*s\033[0m\n' "$remain" ""
}

# Spinner unicode
SPIN=( '⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏' )

run_spin() {
  local msg="$1" cmd="$2"
  if [ "$DRY_RUN" -eq 1 ]; then
    printf '    \033[2m(dry-run)\033[0m %s\n' "$cmd"
    return 0
  fi
  eval "$cmd" &
  local pid=$! i=0
  while kill -0 "$pid" 2>/dev/null; do
    printf "\r    \033[1;34m${SPIN[$i]}\033[0m %s" "$msg"
    i=$(( (i + 1) % ${#SPIN[@]} ))
    sleep 0.1
  done
  wait "$pid"
  local rc=$?
  if [ $rc -eq 0 ]; then
    printf "\r    \033[1;32m✓\033[0m %s\n" "$msg"
  else
    printf "\r    \033[1;33m!\033[0m %s (código $rc)\n" "$msg"
  fi
  return $rc
}

log_history() {
  local histdir="${HISTFILE%/*}"
  mkdir -p "$histdir" 2>/dev/null || return 0
  { printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >> "$HISTFILE"; } 2>/dev/null || true
}

confirm_action() {
  if [ "$NO_CONFIRM" -eq 1 ]; then
    return 0
  fi
  if [ "$INTERACTIVE" -eq 0 ]; then
    return 0
  fi
  local msg="${1:-¿Continuar con la limpieza?}"
  local answer
  read -r -p "$msg (s/N): " answer
  case "$answer" in
    [sS]|[sS][iIíÍ]) return 0 ;;
    *) c_warn "Cancelado por el usuario."; exit 0 ;;
  esac
}

# Versión que no sale del script (útil para preguntas dentro de módulos)
ask_yesno() {
  local msg="${1:-¿Continuar?}"
  local answer
  read -r -p "$msg (s/N): " answer
  case "$answer" in
    [sS]|[sS][iIíÍ]) return 0 ;;
    *) return 1 ;;
  esac
}

need_root() {
  if [ "$(id -u)" -ne 0 ]; then
    if command -v sudo >/dev/null 2>&1; then
      SUDO="sudo"
    else
      c_err "Se requieren privilegios de root para algunas tareas."
      exit 1
    fi
  fi
}

# Ejecuta un comando respetando el modo dry-run
run() {
  if [ "$DRY_RUN" -eq 1 ]; then
    printf '    \033[2m(dry-run)\033[0m %s\n' "$*"
  else
    printf '    \033[38;5;45m→\033[0m %s\n' "$*"
    eval "$@"
  fi
}

usage() {
  cat <<'EOF'

clean - Limpieza de archivos temporales y residuales en Debian

Uso:
  clean [opciones]

Opciones:
  -a, --all       Ejecuta todas las tareas de limpieza (sistema + unidades)
  -t, --temp      Limpia archivos temporales (/tmp, /var/tmp)
  -c, --cache     Limpia la caché de APT y paquetes huérfanos
  -l, --logs      Vacía/rota los logs del sistema (journal + /var/log)
  -T, --trash     Vacía la papelera del usuario
  -m, --thumbs    Limpia miniaturas y cachés de usuario
  -b, --browsers  Limpia la caché de los navegadores (Firefox, Chrome, etc.)
  -r, --ram       Libera page/buffer cache del kernel y swap
  -d, --drives    Limpia papeleras y temporales de unidades montadas
  -u, --user-cache Limpia ~/.cache/ completo y ~/.nv/ (NVIDIA)
  -D, --dev       Limpia cachés de desarrollo (.gradle, .npm, .cargo, pip, etc.)
  -j, --junk      Busca y borra archivos basura seguros (*.swp, *.pyc, .DS_Store, etc.)
  -w, --wine      Limpia temporales y cachés de Wine (~/.wine)
  -M, --media     Limpia cachés multimedia (VLC, MPV, GStreamer, GIMP, etc.)
  -g, --games     Limpia cachés de launchers de juegos (Steam, Lutris, Heroic, etc.)
  -V, --venv      Limpia entornos virtuales Python huérfanos y pip cache
  -K, --apt-check Revisa fuentes APT con errores, duplicados y claves faltantes
  -s, --status    Muestra el uso de disco antes y después de la limpieza
  -n, --dry-run   Muestra lo que se haría sin borrar nada
  -I, --interactive TUI con progreso y confirmación antes de borrar
  -y, --yes       Omite la confirmación interactiva (útil con --all)
  -h, --help      Muestra esta ayuda
EOF
  exit "${1:-0}"
}

# Tamaño legible de una ruta (0 si no existe)
path_size() {
  du -sh "$1" 2>/dev/null | awk '{print $1; exit}'
}

path_key() {
  readlink -f "$1" 2>/dev/null || printf '%s\n' "$1"
}

# ------------------------------------------------------------------ tareas
clean_temp() {
  c_info "Limpiando archivos temporales..."
  for dir in /tmp /var/tmp; do
    [ -d "$dir" ] || continue
    run "$SUDO find '$dir' -mindepth 1 -maxdepth 1 ! -name 'systemd-*' ! -name '.X11-unix' ! -name '.ICE-unix' -exec rm -rf {} + 2>/dev/null"
  done
  c_ok "Temporales limpiados."
}

clean_cache() {
  c_section "CACHÉ DE PAQUETES"

  # Detectar el gestor de paquetes disponible
  if command -v apt-get >/dev/null 2>&1; then
    c_info "  Gestor: APT (Debian/Ubuntu)"
    run_spin "  Limpiando caché APT..." "$SUDO apt-get clean -y"
    run_spin "  Auto-limpieza APT..." "$SUDO apt-get autoclean -y"
    run_spin "  Removiendo huérfanos..." "$SUDO apt-get autoremove --purge -y"
    run "$SUDO find /var/cache/apt/archives -maxdepth 1 -type f -name '*.deb' -delete 2>/dev/null"

    # Purga configuraciones residuales (estado 'rc')
    if command -v dpkg >/dev/null 2>&1; then
      local residual
      residual=$(dpkg -l 2>/dev/null | awk '/^rc/{print $2}' | tr '\n' ' ')
      if [ -n "${residual// /}" ]; then
        c_info "Configuraciones residuales detectadas: $residual"
        run "$SUDO apt-get purge -y $residual"
      else
        c_info "Sin configuraciones residuales."
      fi
    fi

  elif command -v dnf >/dev/null 2>&1; then
    c_info "  Gestor: DNF (Fedora/RHEL)"
    run "$SUDO dnf clean all -y"
    run "$SUDO dnf autoremove -y"

  elif command -v pacman >/dev/null 2>&1; then
    c_info "  Gestor: Pacman (Arch)"
    run "$SUDO pacman -Sc --noconfirm 2>/dev/null"
    # Limpiar metadatos de sincronización
    [ -d "$HOME/.cache/pacman" ] && run "rm -rf '$HOME/.cache/pacman/'* 2>/dev/null"

  elif command -v emerge >/dev/null 2>&1; then
    c_info "  Gestor: Portage (Gentoo)"
    [ -d /var/tmp/portage ] && run "$SUDO rm -rf /var/tmp/portage/* 2>/dev/null"

  else
    c_warn "Sin gestor de paquetes reconocido, se omite limpieza de paquetes."
  fi

  # Limpieza segura de /var/cache (cachés regenerables, común a todas las distros)
  c_info "Limpiando cachés seguras de /var/cache..."
  [ -d /var/cache/fontconfig ] && run "$SUDO rm -rf /var/cache/fontconfig/* 2>/dev/null"
  [ -d /var/cache/man ]        && run "$SUDO rm -rf /var/cache/man/* 2>/dev/null"
  [ -d /var/cache/thumbnails ] && run "$SUDO rm -rf /var/cache/thumbnails/* 2>/dev/null"

  c_ok "Caché de paquetes limpiada."
}

clean_apt_check() {
  c_section "REVISIÓN DE FUENTES APT"

  if ! command -v apt-get >/dev/null 2>&1; then
    c_warn "APT no disponible, se omite revisión."
    return
  fi

  local issues=0

  # Ejecutar apt-get update UNA SOLA VEZ y capturar todo
  c_info "Ejecutando apt-get update para diagnóstico..."
  local apt_output
  apt_output=$(apt-get update 2>&1) || true

  # 1. Buscar duplicados
  local dupes
  dupes=$(echo "$apt_output" | grep -oP "El objetivo .* está configurado varias veces" | sed 's/El objetivo /  /' | sort -u || true)
  if [ -n "$dupes" ]; then
    c_warn "Repositorios configurados múltiples veces:"
    echo "$dupes"
    c_info "  Solución: revisá /etc/apt/sources.list y /etc/apt/sources.list.d/"
    c_info "  y eliminá las líneas duplicadas. Luego: sudo apt update"
    issues=$((issues + 1))
  fi

  # 2. Claves GPG faltantes
  local key_errors
  key_errors=$(echo "$apt_output" | grep -iE "NO_PUBKEY|GPG error|public key is not available" | sed 's/^/  /' || true)
  if [ -n "$key_errors" ]; then
    c_warn "Errores de claves GPG:"
    echo "$key_errors"
    c_info "  Solución: sudo apt-key adv --keyserver keyserver.ubuntu.com --recv-keys <ID>"
    issues=$((issues + 1))
  fi

  # 3. Repos caídos o inaccesibles
  local dead_repos
  dead_repos=$(echo "$apt_output" | grep -iE "404  Not Found|No se pudo resolver|Could not resolve|Connection failed|Temporary failure" | sed 's/^/  /' || true)
  if [ -n "$dead_repos" ]; then
    c_warn "Repositorios inaccesibles o caídos:"
    echo "$dead_repos"
    issues=$((issues + 1))
  fi

  # 4. Archivos .list y .sources mezclados (puede causar conflictos)
  local has_list=0 has_sources=0
  [ -n "$(ls /etc/apt/sources.list.d/*.list 2>/dev/null)" ] && has_list=1
  [ -n "$(ls /etc/apt/sources.list.d/*.sources 2>/dev/null)" ] && has_sources=1
  if [ "$has_list" -eq 1 ] && [ "$has_sources" -eq 1 ]; then
    c_info "  Conviven .list y .sources en sources.list.d/ (puede generar duplicados)."
  fi

  # 5. Auto-fix: ofrecer arreglar duplicados comentando sources.list
  local fix_lines
  fix_lines=$(echo "$apt_output" | grep -oP 'en \S+:\d+' | grep 'sources\.list:' | sort -u || true)
  if [ -n "$fix_lines" ] && [ "$issues" -gt 0 ]; then
    echo
    c_info "Líneas duplicadas detectadas en /etc/apt/sources.list:"
    echo
    local ln
    while IFS= read -r entry; do
      [ -z "$entry" ] && continue
      local file="${entry%%:*}"
      local num="${entry##*:}"
      local content
      content=$(sed -n "${num}p" "$file" 2>/dev/null)
      printf '    \033[1;33mLínea %s:\033[0m \033[2m%s\033[0m\n' "$num" "$content"
    done <<< "$fix_lines"
    echo
    c_info "Estas líneas están duplicadas por archivos .sources equivalentes."
    c_info "El fix seguro es comentarlas en sources.list (las .sources tienen prioridad)."

    if [ "$DRY_RUN" -eq 0 ]; then
      confirm_action "¿Comentar estas líneas duplicadas en sources.list?"
      local comment_rc=$?
      if [ $comment_rc -eq 0 ]; then
        while IFS= read -r entry; do
          [ -z "$entry" ] && continue
          local file="${entry%%:*}"
          local num="${entry##*:}"
          $SUDO sed -i "${num}s/^/# CLEAN: duplicado --> /" "$file" 2>/dev/null
          c_ok "  Comentada línea $num en $file"
        done <<< "$fix_lines"
        c_info "Ejecutá 'sudo apt update' para verificar que no haya más warnings."
      fi
    else
      printf '    \033[2m(dry-run)\033[0m Se comentarían las líneas en sources.list\n'
    fi
  fi

  if [ "$issues" -eq 0 ]; then
    c_ok "No se detectaron problemas en las fuentes de APT."
  else
    c_warn "Se detectaron $issues tipo(s) de problema(s) en las fuentes APT."
  fi
  c_ok "Revisión de fuentes APT completada."
}

clean_logs() {
  c_section "LOGS DEL SISTEMA"
  if command -v journalctl >/dev/null 2>&1; then
    run_spin "  Rotando journal..." "$SUDO journalctl --rotate"
    run_spin "  Compactando journal (3d)..." "$SUDO journalctl --vacuum-time=3d"
  fi
  run "$SUDO find /var/log -type f -name '*.gz' -delete 2>/dev/null"
  run "$SUDO find /var/log -type f -regextype posix-extended -regex '.*\.[0-9]+$' -delete 2>/dev/null"
  # Coredumps de systemd (volcados de memoria)
  if [ -d /var/lib/systemd/coredump ]; then
    local cdump
    cdump=$(find /var/lib/systemd/coredump -type f -size +0 2>/dev/null | wc -l)
    if [ "$cdump" -gt 0 ]; then
      c_info "Eliminando ${cdump} volcado(s) de memoria (coredump)..."
      run "$SUDO rm -rf /var/lib/systemd/coredump/* 2>/dev/null"
    fi
  fi
  c_ok "Logs limpiados."
}

clean_trash() {
  c_info "Vaciando papelera del usuario..."
  local trash="${XDG_DATA_HOME:-$HOME/.local/share}/Trash"
  if [ -d "$trash" ]; then
    run "rm -rf '$trash/files/'* '$trash/info/'* 2>/dev/null"
  fi
  c_ok "Papelera vaciada."
}

clean_thumbs() {
  c_info "Limpiando miniaturas y cachés de usuario..."
  local cache="${XDG_CACHE_HOME:-$HOME/.cache}"
  [ -d "$cache/thumbnails" ] && run "rm -rf '$cache/thumbnails/'* 2>/dev/null"
  [ -d "$HOME/.thumbnails" ]  && run "rm -rf '$HOME/.thumbnails/'* 2>/dev/null"
  c_ok "Miniaturas limpiadas."
}

clean_browsers() {
  c_section "CACHÉ DE NAVEGADORES"
  local cache="${XDG_CACHE_HOME:-$HOME/.cache}"
  local cfg="${XDG_CONFIG_HOME:-$HOME/.config}"

  # Mapa de procesos para detectar navegadores abiertos
  local browsers_procs="firefox firefox-esr firefox-bin chrome chromium chromium-browser brave brave-browser opera vivaldi-bin microsoft-edge msedge librewolf floorp waterfox tor-browser palemoon basilisk falkon qutebrowser midori epiphany zen"
  local open=""
  local b
  for b in $browsers_procs; do
    if pgrep -x -u "$(id -u)" "$b" >/dev/null 2>&1; then
      open="$open $b"
    fi
  done
  if [ -n "$open" ] && [ "$DRY_RUN" -eq 0 ]; then
    c_warn "Navegadores abiertos:$open (ciérralos para una limpieza completa)."
  fi

  # ---- Navegadores (nombre → directorio de config) ----
  # Cada entrada: "Label|ruta_config"
  declare -A BROWSERS=()

  # Chromium / Blink
  BROWSERS["Google Chrome"]="$cfg/google-chrome"
  BROWSERS["Chromium"]="$cfg/chromium"
  BROWSERS["Brave"]="$cfg/BraveSoftware/Brave-Browser"
  BROWSERS["Microsoft Edge"]="$cfg/microsoft-edge"
  BROWSERS["Opera"]="$cfg/opera"
  BROWSERS["Vivaldi"]="$cfg/vivaldi"
  BROWSERS["qutebrowser"]="$cfg/qutebrowser"
  BROWSERS["Falkon"]="$cfg/falkon"
  BROWSERS["Midori"]="$cfg/midori"
  BROWSERS["Iridium"]="$cfg/iridium"
  BROWSERS["Slimjet"]="$cfg/slimjet"
  BROWSERS["Dissenter"]="$cfg/dissenter"
  BROWSERS["Epiphany (GNOME Web)"]="$cfg/epiphany"
  BROWSERS["Ghostery"]="$cfg/Ghostery"

  # Firefox / Gecko
  BROWSERS["Firefox"]="$HOME/.mozilla/firefox"
  BROWSERS["LibreWolf"]="$HOME/.librewolf"
  BROWSERS["Floorp"]="$HOME/.floorp"
  BROWSERS["Waterfox"]="$HOME/.waterfox"
  BROWSERS["Zen Browser"]="$HOME/.zen"
  BROWSERS["Pale Moon"]="$HOME/.moonchild productions/pale moon"
  BROWSERS["Basilisk"]="$HOME/.moonchild productions/basilisk"
  BROWSERS["Tor Browser"]="$HOME/.tor-browser"

  # Primero contar cuántos navegadores hay instalados
  local total=0 current=0
  for name in "${!BROWSERS[@]}"; do
    [ -d "${BROWSERS[$name]}" ] && total=$((total + 1))
  done
  if [ "$total" -eq 0 ]; then
    c_info "  No se detectaron navegadores instalados."
    c_ok "Caché de navegadores limpiada."
    return
  fi

  for name in "${!BROWSERS[@]}"; do
    local base="${BROWSERS[$name]}"
    [ -d "$base" ] || continue
    current=$((current + 1))

    local prefix
    prefix=$(printf '  \033[1;34m[%d/%d]\033[0m %s' "$current" "$total" "$name")

    case "$name" in
      # ---- Navegadores basados en Chromium/Blink ----
      "Google Chrome"|"Chromium"|"Brave"|"Microsoft Edge"|"Opera"|"Vivaldi"|"Falkon"|"Midori"|"Iridium"|"Slimjet"|"Dissenter"|"Ghostery")
        printf '%s\n' "$prefix"
        run "rm -rf '$base'/*/Cache/* '$base'/*/'Code Cache'/* '$base'/*/GPUCache/* '$base'/*/ShaderCache/* 2>/dev/null"
        ;;

      # ---- qutebrowser (cache separado en ~/.cache) ----
      "qutebrowser")
        printf '%s\n' "$prefix"
        run "rm -rf '$cache/qutebrowser/'* '$base/'*/webengine/Cache/* 2>/dev/null"
        ;;

      # ---- Epiphany (GNOME Web / WebKit) ----
      "Epiphany (GNOME Web)")
        printf '%s\n' "$prefix"
        run "rm -rf '$cache/epiphany/'* 2>/dev/null"
        ;;

      # ---- Navegadores basados en Firefox / Gecko ----
      *)
        printf '%s\n' "$prefix"
        run "rm -rf '$base/'*/cache2/* '$base/'*/startupCache/* '$base/'*/thumbnails/* 2>/dev/null"
        ;; 
    esac
  done

  # Cachés adicionales en ~/.cache (Chromium-based que guardan cache acá)
  for d in google-chrome chromium BraveSoftware opera vivaldi microsoft-edge falkon midori iridium slimjet epiphany; do
    if [ -d "$cache/$d" ] && [ -n "$(ls -A "$cache/$d" 2>/dev/null)" ]; then
      c_info "  ~/.cache/$d"
      run "rm -rf '$cache/$d/'* 2>/dev/null"
    fi
  done

  c_ok "Caché de navegadores limpiada (${total} encontrados)."
}

clean_ram() {
  c_info "Liberando caché del kernel (page/buffer cache) en RAM..."
  if [ "$DRY_RUN" -eq 0 ] && command -v free >/dev/null 2>&1; then
    c_info "  Antes: $(free -h | awk '/Mem:/{print "usada "$3", cache "$6}')"
  fi
  run "sync"
  run "$SUDO sh -c 'echo 3 > /proc/sys/vm/drop_caches'"
  if [ "$DRY_RUN" -eq 0 ] && command -v free >/dev/null 2>&1; then
    c_info "  Después: $(free -h | awk '/Mem:/{print "usada "$3", cache "$6}')"
  fi
  c_ok "Caché de RAM liberada (no se borraron datos)."

  # Limpiar swap (manda todo de vuelta a RAM si hay espacio)
  if command -v swapon >/dev/null 2>&1; then
    local swaps
    swaps=$(swapon --show=NAME --noheadings 2>/dev/null | wc -l)
    if [ "$swaps" -gt 0 ]; then
      c_info "Vaciando swap (swapoff/on)..."
      if [ "$DRY_RUN" -eq 0 ]; then
        $SUDO swapoff -a 2>/dev/null && $SUDO swapon -a 2>/dev/null || c_warn "No se pudo vaciar el swap (RAM insuficiente?)."
      else
        printf '    \033[2m(dry-run)\033[0m sudo swapoff -a && sudo swapon -a\n'
      fi
    fi
  fi
  c_ok "RAM y swap limpiados."
}

clean_drives() {
  c_info "Limpiando unidades montadas (papeleras y temporales)..."
  local mounts
  mounts=$(findmnt -rn -o TARGET -t vfat,exfat,ntfs,ext4,ext3,ext2,btrfs,xfs 2>/dev/null \
            | grep -E '^/(media|mnt|run/media|home)/' || true)
  if [ -z "$mounts" ]; then
    c_warn "No se detectaron unidades montadas en /media, /mnt, /run/media o /home."
    return
  fi
  local drive_total=0 drive_cur=0
  while IFS= read -r mp2; do [ -n "$mp2" ] && [ "$mp2" != "$HOME" ] && drive_total=$((drive_total + 1)); done <<< "$mounts"
  if [ "$drive_total" -eq 0 ]; then return; fi
  while IFS= read -r mp; do
    [ -z "$mp" ] && continue
    [ "$mp" = "$HOME" ] && continue
    drive_cur=$((drive_cur + 1))
    printf '  \033[1;34m[%d/%d]\033[0m Unidad: %s\n' "$drive_cur" "$drive_total" "$mp"
    run "$SUDO find '$mp' -maxdepth 3 -type d -name '.Trash-*' -exec rm -rf {} + 2>/dev/null"
    run "$SUDO find '$mp' -maxdepth 3 -type d -iname '\$RECYCLE.BIN' -exec rm -rf {} + 2>/dev/null"
    run "$SUDO find '$mp' -maxdepth 2 -type f -name 'Thumbs.db' -delete 2>/dev/null"
    run "$SUDO find '$mp' -maxdepth 2 -type f -name '.DS_Store' -delete 2>/dev/null"
  done <<< "$mounts"
  c_ok "Unidades limpiadas."
}

clean_user_cache() {
  c_info "Limpiando caché completo de usuario (~/.cache)..."
  local cache="${XDG_CACHE_HOME:-$HOME/.cache}"
  if [ -d "$cache" ]; then
    local before
    before=$(path_size "$cache")
    # Borra todo ~/.cache excepto el propio script de limpieza
    run "find '$cache' -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null"
    local after
    after=$(path_size "$cache")
    c_info "  Antes: ${before:-?}  Después: ${after:-?}"
  fi

  # NVIDIA shader cache
  if [ -d "$HOME/.nv" ]; then
    local nv_size
    nv_size=$(path_size "$HOME/.nv")
    c_info "Limpiando caché NVIDIA (~/.nv): ${nv_size:-?}"
    run "rm -rf '$HOME/.nv/'* 2>/dev/null"
  fi
  # Mesa (OpenGL/Vulkan) shader cache
  if [ -d "$HOME/.mesa_shader_cache" ]; then
    local mesa_size
    mesa_size=$(path_size "$HOME/.mesa_shader_cache")
    c_info "Limpiando Mesa shader cache (~/.mesa_shader_cache): ${mesa_size:-?}"
    run "rm -rf '$HOME/.mesa_shader_cache/'* 2>/dev/null"
  fi
  c_ok "Caché de usuario limpiada."
}

clean_dev() {
  c_info "Limpiando cachés de herramientas de desarrollo..."
  local found=0

  # Gradle
  if [ -d "$HOME/.gradle/caches" ]; then
    c_info "  Gradle"
    run "rm -rf '$HOME/.gradle/caches/'* 2>/dev/null"
    found=1
  fi
  # npm
  if [ -d "$HOME/.npm/_cacache" ]; then
    c_info "  npm"
    run "rm -rf '$HOME/.npm/_cacache/'* 2>/dev/null"
    found=1
  fi
  # Cargo (Rust) - más profundo
  if [ -d "$HOME/.cargo/registry/cache" ]; then
    c_info "  Cargo (registry cache)"
    run "rm -rf '$HOME/.cargo/registry/cache/'* 2>/dev/null"
    found=1
  fi
  if [ -d "$HOME/.cargo/registry/src" ]; then
    c_info "  Cargo (registry src)"
    run "rm -rf '$HOME/.cargo/registry/src/'* 2>/dev/null"
    found=1
  fi
  # Cargo toolchain cache
  if [ -d "$HOME/.rustup/toolchains" ]; then
    c_info "  Rustup (toolchain downloads)"
    run "find '$HOME/.rustup' -name '*.tmp' -o -name '*.partial' 2>/dev/null -delete"
    found=1
  fi
  # pip (Python) - caché completa de descargas
  local pip_cache="${XDG_CACHE_HOME:-$HOME/.cache}/pip"
  if [ -d "$pip_cache" ]; then
    c_info "  pip (HTTP/wheels cache)"
    run "rm -rf '$pip_cache/'* 2>/dev/null"
    found=1
  fi
  # pip cache purge (wheels y HTTP cache interna)
  for pip_cmd in pip3 pip; do
    if command -v "$pip_cmd" >/dev/null 2>&1 && [ "$DRY_RUN" -eq 0 ]; then
      c_info "  ${pip_cmd} cache purge"
      run "$pip_cmd cache purge 2>/dev/null"
      found=1
      break
    fi
  done
  # Yarn
  if [ -d "$HOME/.yarn/cache" ]; then
    c_info "  Yarn"
    run "rm -rf '$HOME/.yarn/cache/'* 2>/dev/null"
    found=1
  fi
  # Maven (~/.m2/repository)
  if [ -d "$HOME/.m2/repository" ]; then
    c_info "  Maven (se omite ~/.m2/repository completo, solo descargas parciales)"
    run "find '$HOME/.m2/repository' -type f -name '*.jar' -size 0 -delete 2>/dev/null"
    run "find '$HOME/.m2/repository' -type f -name '*.lastUpdated' -delete 2>/dev/null"
    found=1
  fi
  # Go module cache - profundo
  if [ -d "$HOME/go/pkg/mod/cache" ]; then
    c_info "  Go modules (download cache)"
    run "rm -rf '$HOME/go/pkg/mod/cache/'* 2>/dev/null"
    found=1
  fi
  # go clean nativo (si go está en PATH)
  if command -v go >/dev/null 2>&1; then
    if [ "$DRY_RUN" -eq 0 ]; then
      c_info "  go clean -cache -modcache"
      GOPATH="${GOPATH:-$HOME/go}" run "go clean -cache 2>/dev/null"
      GOPATH="${GOPATH:-$HOME/go}" run "go clean -modcache 2>/dev/null"
    else
      printf '    \033[2m(dry-run)\033[0m %s\n' "go clean -cache && go clean -modcache"
    fi
    found=1
  fi
  # node_modules/.cache (webpack, babel, etc.)
  if [ -n "$(find "$HOME" -maxdepth 5 -path '*/node_modules/.cache' -type d -print -quit 2>/dev/null)" ]; then
    c_info "  node_modules/.cache"
    run "find '$HOME' -maxdepth 5 -path '*/node_modules/.cache' -type d -exec rm -rf {} + 2>/dev/null"
    found=1
  fi
  # node_modules/ huérfanos (sin package.json en el proyecto padre)
  if [ "$DRY_RUN" -eq 0 ]; then
    local orphan_nm=0
    mapfile -t nm_dirs < <(find "$HOME" -maxdepth 5 -type d -name 'node_modules' 2>/dev/null)
    for nm in "${nm_dirs[@]}"; do
      local parent
      parent=$(dirname "$nm")
      # Si no hay package.json en el padre, está huérfano
      if [ ! -f "$parent/package.json" ]; then
        orphan_nm=$((orphan_nm + 1))
        local short
        short=$(echo "$nm" | sed "s|$HOME|~|")
        c_info "  HUÉRFANO: $short ($(path_size "$nm"))"
        run "rm -rf '$nm' 2>/dev/null"
      fi
    done
    if [ "$orphan_nm" -gt 0 ]; then
      c_info "  $orphan_nm node_modules huérfano(s) eliminado(s)."
      found=1
    fi
  fi

  if [ "$found" -eq 0 ]; then
    c_info "  No se detectaron herramientas de desarrollo con caché."
  fi
  c_ok "Cachés de desarrollo limpiadas."
}

clean_wine() {
  c_info "Limpiando temporales y cachés de Wine..."
  local wine_dir="$HOME/.wine"
  if [ ! -d "$wine_dir" ]; then
    c_info "  Wine no está instalado (no existe ~/.wine)."
    return
  fi

  local user_name
  user_name=$(id -un 2>/dev/null || echo "$USER")

  local paths=(
    "$wine_dir/drive_c/users/$user_name/Temp"
    "$wine_dir/drive_c/users/$user_name/AppData/Local/Temp"
    "$wine_dir/drive_c/users/$user_name/AppData/Local/Microsoft/Windows/INetCache"
    "$wine_dir/drive_c/users/$user_name/AppData/Local/CrashDumps"
    "$wine_dir/drive_c/windows/temp"
  )

  local found=0
  for p in "${paths[@]}"; do
    if [ -d "$p" ]; then
      found=1
      c_info "  $(echo "$p" | sed "s|$wine_dir|~/.wine|")"
      run "rm -rf '$p/'* 2>/dev/null"
    fi
  done

  # También buscar en otros prefixes de Wine (Lutris, PlayOnLinux, etc.)
  for prefix in "$HOME/.wine" "$HOME/Games" "$HOME/.PlayOnLinux/wineprefix" "$HOME/.local/share/lutris" "$HOME/.local/share/bottles"; do
    if [ -d "$prefix" ]; then
      c_info "  Buscando temporales en $prefix..."
      run "find '$prefix' -maxdepth 5 -type d \( -name 'Temp' -o -name 'INetCache' -o -name 'CrashDumps' \) -exec rm -rf {}/'*' \; 2>/dev/null"
      found=1
    fi
  done

  if [ "$found" -eq 0 ]; then
    c_info "  No se encontraron temporales de Wine."
  fi
  c_ok "Temporales de Wine limpiados."
}

clean_media() {
  c_section "CACHÉ MULTIMEDIA"

  local found=0
  local cache="${XDG_CACHE_HOME:-$HOME/.cache}"
  local cfg="${XDG_CONFIG_HOME:-$HOME/.config}"
  local data="${XDG_DATA_HOME:-$HOME/.local/share}"
  local seen_paths="|"

  clean_media_dir() {
    local d="$1"
    [ -d "$d" ] || return 0
    local key
    key=$(path_key "$d")
    case "$seen_paths" in *"|$key|"*) return 0 ;; esac
    seen_paths="${seen_paths}${key}|"
    found=$((found + 1))
    c_info "  $(echo "$d" | sed "s|$HOME|~|")"
    run "rm -rf '$d/'* 2>/dev/null"
  }

  # ── Audio ──
  # PulseAudio / PipeWire (caché se regenera, seguro incluso andando)
  # Si está corriendo, ofrecemos reiniciarlo para limpiar a fondo
  local restart_pipewire=0 restart_pulse=0

  if pgrep -x pipewire >/dev/null 2>&1; then
    c_warn "  PipeWire está corriendo."
    if [ "$DRY_RUN" -eq 0 ] && command -v systemctl >/dev/null 2>&1; then
      if ask_yesno "¿Reiniciar PipeWire para limpiar su caché? (audio se corta 1-2s)"; then
        restart_pipewire=1
      fi
    fi
  fi
  if pgrep -x pulseaudio >/dev/null 2>&1; then
    c_warn "  PulseAudio está corriendo."
    if [ "$DRY_RUN" -eq 0 ] && command -v systemctl >/dev/null 2>&1; then
      if ask_yesno "¿Reiniciar PulseAudio para limpiar su caché? (audio se corta 1-2s)"; then
        restart_pulse=1
      fi
    fi
  fi

  # Parar los servicios si el usuario aceptó
  if [ "$restart_pipewire" -eq 1 ]; then
    c_info "  Deteniendo PipeWire..."
    run "systemctl --user stop pipewire.service pipewire-pulse.service pipewire.socket 2>/dev/null"
  fi
  if [ "$restart_pulse" -eq 1 ]; then
    c_info "  Deteniendo PulseAudio..."
    run "systemctl --user stop pulseaudio.service pulseaudio.socket 2>/dev/null"
  fi

  # Limpiar cachés
  if [ -d "$cache/pulse" ]; then
    clean_media_dir "$cache/pulse"
  fi
  if [ -d "$cache/pipewire" ]; then
    clean_media_dir "$cache/pipewire"
  fi

  # Rearrancar los servicios
  if [ "$restart_pipewire" -eq 1 ]; then
    c_info "  Rearrancando PipeWire..."
    run "systemctl --user start pipewire.socket pipewire.service pipewire-pulse.service 2>/dev/null"
  fi
  if [ "$restart_pulse" -eq 1 ]; then
    c_info "  Rearrancando PulseAudio..."
    run "systemctl --user start pulseaudio.socket pulseaudio.service 2>/dev/null"
  fi

  # ── Video, streaming y edición ──
  local video_dirs=(
    "$cache/gstreamer-1.0"
    "$cache/vlc"
    "$cache/mpv"
    "$cache/ffmpeg"
    "$cache/obs-studio"
    "$cfg/obs-studio/logs"
    "$cache/kdenlive"
    "$data/kdenlive/proxy"
    "$cache/shotcut"
    "$cfg/Meltytech/Shotcut/cache"
    "$cache/OpenShot"
    "$cache/openshot-qt"
    "$data/openshot_qt/thumbnail"
    "$cache/pitivi"
    "$cache/HandBrake"
    "$cache/DaVinciResolve"
    "$cache/BlackmagicDesign/DaVinci Resolve"
    "$cache/blender"
  )
  for d in "${video_dirs[@]}"; do
    clean_media_dir "$d"
  done

  # ── Fotografía, dibujo y edición de imágenes ──
  local image_dirs=(
    "$cache/eog"
    "$cache/gimp"
    "$cache/krita"
    "$cache/inkscape"
    "$cache/darktable"
    "$cache/rawtherapee"
    "$cache/digikam"
    "$cache/shotwell"
    "$cache/gthumb"
    "$cache/nomacs"
    "$cache/pinta"
    "$cache/mypaint"
    "$cache/rapid-photo-downloader"
    "$cfg/GIMP/*/tmp"
    "$cfg/GIMP/*/templaterc.d"
    "$cfg/krita/cache"
    "$cfg/darktable/cached_kernels_for_*"
    "$cfg/RawTherapee*/cache"
    "$data/Trash/files/gimp-temp-*"
  )
  for d in "${image_dirs[@]}"; do
    for expanded in $d; do
      clean_media_dir "$expanded"
    done
  done

  # ── Audio, música y DAWs ──
  local music_dirs=(
    "$cache/rhythmbox"
    "$cache/audacious"
    "$cache/clementine"
    "$cache/deadbeef"
    "$cache/strawberry"
    "$cache/lollypop"
    "$cache/quodlibet"
    "$cache/audacity"
    "$cfg/audacity/SessionData"
    "$cache/ardour6"
    "$cache/ardour7"
    "$cache/ardour8"
    "$cache/lmms"
    "$cache/mixxx"
  )
  for d in "${music_dirs[@]}"; do
    clean_media_dir "$d"
  done

  # ── Display managers (solo si no hay sesión gráfica activa) ──
  if [ -z "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ]; then
    for dm in /var/cache/lightdm /var/cache/sddm /var/cache/gdm; do
      if [ -d "$dm" ]; then
        c_info "  $dm"
        run "$SUDO rm -rf '$dm/'* 2>/dev/null"
        found=$((found + 1))
      fi
    done
  fi

  if [ "$found" -eq 0 ]; then
    c_info "  No se detectaron cachés multimedia."
  else
    c_info "  $found ruta(s) multimedia limpiada(s)."
  fi
  c_ok "Caché multimedia limpiada."
}

clean_games() {
  c_section "CACHÉ DE JUEGOS"

  local found=0
  local cache="${XDG_CACHE_HOME:-$HOME/.cache}"
  local cfg="${XDG_CONFIG_HOME:-$HOME/.config}"
  local data="${XDG_DATA_HOME:-$HOME/.local/share}"

  local game_procs="steam steamwebhelper lutris heroic heroic-games-launcher itch legendary bottles minigalaxy retroarch prismlauncher"
  local open=""
  local proc
  for proc in $game_procs; do
    if pgrep -x -u "$(id -u)" "$proc" >/dev/null 2>&1; then
      open="$open $proc"
    fi
  done
  if [ -n "$open" ] && [ "$DRY_RUN" -eq 0 ]; then
    c_warn "Launchers de juegos abiertos:$open (ciérralos para una limpieza completa)."
  fi

  local steam_roots=(
    "$HOME/.steam/steam"
    "$data/Steam"
  )
  local seen_paths="|"
  local steam_root
  for steam_root in "${steam_roots[@]}"; do
    [ -d "$steam_root" ] || continue

    local steam_paths=(
      "$steam_root/appcache/httpcache"
      "$steam_root/config/htmlcache"
      "$steam_root/logs"
      "$steam_root/steamapps/shadercache"
      "$steam_root/steamapps/temp"
    )
    local p
    for p in "${steam_paths[@]}"; do
      [ -d "$p" ] || continue
      local key
      key=$(path_key "$p")
      case "$seen_paths" in *"|$key|"*) continue ;; esac
      seen_paths="${seen_paths}${key}|"
      found=1
      c_info "  $(echo "$p" | sed "s|$HOME|~|")"
      run "rm -rf '$p/'* 2>/dev/null"
    done
  done

  local game_dirs=(
    "$cache/lutris"
    "$data/lutris/cache"
    "$cfg/lutris/cache"
    "$cache/heroic"
    "$cfg/heroic/Cache"
    "$cfg/heroic/Code Cache"
    "$cfg/heroic/GPUCache"
    "$cfg/heroic/logs"
    "$cache/legendary"
    "$cfg/legendary/logs"
    "$cache/itch"
    "$cfg/itch/Cache"
    "$cfg/itch/Code Cache"
    "$cfg/itch/GPUCache"
    "$cache/bottles"
    "$data/bottles/temp"
    "$cache/minigalaxy"
    "$cache/retroarch"
    "$data/PrismLauncher/cache"
    "$data/PrismLauncher/logs"
    "$HOME/.minecraft/logs"
    "$HOME/.minecraft/crash-reports"
  )

  local d
  for d in "${game_dirs[@]}"; do
    if [ -d "$d" ]; then
      local key
      key=$(path_key "$d")
      case "$seen_paths" in *"|$key|"*) continue ;; esac
      seen_paths="${seen_paths}${key}|"
      found=1
      c_info "  $(echo "$d" | sed "s|$HOME|~|")"
      run "rm -rf '$d/'* 2>/dev/null"
    fi
  done

  if [ "$found" -eq 0 ]; then
    c_info "  No se detectaron cachés de juegos."
  fi
  c_ok "Cachés de juegos limpiadas."
}

clean_junk() {
  c_info "Buscando y limpiando archivos basura seguros..."
  local search_dirs=(
    /tmp /var/tmp "$HOME/Downloads" "$HOME/Desktop" "$HOME/Documentos" "$HOME/Documents" "$HOME/Escritorio"
  )
  local total=0

  # Patrones seguros de borrar
  local patterns=(-name "*.swp" -o -name "*.swo" -o -name "*.bak" -o -name "*.old" -o -name "*.part" -o -name "*.crdownload" -o -name "*.unfinished" -o -name "*.tmp" -o -name "*.temp" -o -name "*.lock")

  for dir in "${search_dirs[@]}"; do
    [ -d "$dir" ] || continue
    local count
    count=$(find "$dir" -maxdepth 3 -type f \( "${patterns[@]}" \) 2>/dev/null | wc -l)
    if [ "$count" -gt 0 ]; then
      c_info "  $dir: ${count} archivo(s)"
      run "find '$dir' -maxdepth 3 -type f \( ${patterns[*]} \) -delete 2>/dev/null"
      total=$((total + count))
    fi
  done

  # Archivos vacíos (0 KB) en /tmp, /var/tmp, ~/Downloads
  for dir in /tmp /var/tmp "$HOME/Downloads"; do
    [ -d "$dir" ] || continue
    local empty
    empty=$(find "$dir" -maxdepth 3 -type f -size 0 2>/dev/null | wc -l)
    if [ "$empty" -gt 0 ]; then
      c_info "  $dir: ${empty} archivo(s) vacío(s)"
      run "find '$dir' -maxdepth 3 -type f -size 0 -delete 2>/dev/null"
      total=$((total + empty))
    fi
  done

  # __pycache__ en home (bytecode de Python, se regenera solo)
  if [ -d "$HOME" ]; then
    local pycache
    pycache=$(find "$HOME" -maxdepth 6 -path '*/__pycache__' -type d 2>/dev/null | wc -l)
    if [ "$pycache" -gt 0 ]; then
      c_info "  __pycache__/: ${pycache} directorio(s) en ~/"
      run "find '$HOME' -maxdepth 6 -path '*/__pycache__' -type d -exec rm -rf {} + 2>/dev/null"
    fi
  fi

  if [ "$total" -eq 0 ] && [ "${pycache:-0}" -eq 0 ]; then
    c_info "  No se encontró basura."
  else
    c_info "  Total eliminado: ${total} archivos basura + ${pycache:-0} __pycache__"
  fi
  c_ok "Basura limpiada."
}

clean_venv() {
  c_section "ENTORNOS VIRTUALES PYTHON"

  local found=0 orphan=0
  local marker_files=("requirements.txt" "requirements.in" "pyproject.toml" "setup.py" "setup.cfg" "Pipfile" "Pipfile.lock" "poetry.lock")

  c_info "Buscando entornos virtuales huérfanos..."

  # Buscar venvs (directorios que contienen pyvenv.cfg) bajo $HOME
  local venvs
  mapfile -t venvs < <(find "$HOME" -maxdepth 5 -type f -name 'pyvenv.cfg' 2>/dev/null)

  for cfg in "${venvs[@]}"; do
    local venv_dir
    venv_dir=$(dirname "$cfg")
    local parent_dir
    parent_dir=$(dirname "$venv_dir")

    # Es solo un venv si tiene bin/python o bin/activate
    [ -f "$venv_dir/bin/activate" ] || [ -f "$venv_dir/Scripts/activate" ] || continue
    found=$((found + 1))

    # Verificar si el proyecto padre es activo (tiene archivos de proyecto Python)
    local is_active=0
    for mf in "${marker_files[@]}"; do
      # Buscar en el padre o un nivel arriba (monorepos)
      if [ -f "$parent_dir/$mf" ] || [ -f "$venv_dir/../$mf" ]; then
        is_active=1
        break
      fi
    done

    if [ "$is_active" -eq 1 ]; then
      # Venv activo: solo limpiar cache interna, no borrar el venv
      local cache_dirs=("$venv_dir/lib/python"*"/site-packages/pip/_vendor/cachecontrol" "$venv_dir/pip-wheel-metadata")
      for cd in "${cache_dirs[@]}"; do
        [ -d "$cd" ] && run "rm -rf '$cd/'* 2>/dev/null"
      done
    else
      # Venv huérfano: borrar completo
      orphan=$((orphan + 1))
      local short
      short=$(echo "$venv_dir" | sed "s|$HOME|~|")
      c_info "  HUÉRFANO: $short ($(path_size "$venv_dir"))"
      if [ "$DRY_RUN" -eq 0 ]; then
        run "rm -rf '$venv_dir' 2>/dev/null"
      fi
    fi
  done

  # Limpiar ~/.virtualenvs y pipenv cache
  for d in "$HOME/.virtualenvs" "$HOME/.local/share/virtualenvs"; do
    if [ -d "$d" ]; then
      c_info "  Virtualenvs: $d ($(path_size "$d"))"
      run "find '$d' -type d -name '__pycache__' -exec rm -rf {} + 2>/dev/null"
      run "find '$d' -type f -name '*.pyc' -delete 2>/dev/null"
    fi
  done

  # pip cache vieja (ruedas, HTTP, etc.)
  for pip_cmd in pip3 pip; do
    if command -v "$pip_cmd" >/dev/null 2>&1 && [ "$DRY_RUN" -eq 0 ]; then
      c_info "  ${pip_cmd} cache purge"
      run "$pip_cmd cache purge 2>/dev/null"
      break
    fi
  done

  if [ "$found" -eq 0 ]; then
    c_info "  No se detectaron entornos virtuales."
  else
    c_info "  $found venv(s) encontrados, $orphan huérfano(s) eliminado(s)."
    [ "$found" -gt "$orphan" ] && c_info "  $(($found - $orphan)) venv(s) de proyectos activos preservados."
  fi

  c_ok "Entornos virtuales limpiados."
}

clean_status() {
  c_info "Uso de disco antes/después:"
  printf '\n'
  printf '  %-30s %12s  →  %-12s\n' "RUTA" "ANTES" "AHORA"
  printf '  %-30s %12s  →  %-12s\n' "---" "-----" "----"

  local paths=(/tmp /var/tmp /var/cache ~/.cache ~/.local/share/Trash ~/.nv /var/log ~/.cache/vlc ~/.cache/mpv ~/.cache/obs-studio ~/.cache/kdenlive ~/.cache/shotcut ~/.cache/OpenShot ~/.cache/gimp ~/.cache/krita ~/.cache/inkscape ~/.cache/darktable ~/.cache/rawtherapee ~/.cache/digikam ~/.cache/audacity ~/.cache/ardour8 ~/.steam/steam/steamapps/shadercache ~/.local/share/Steam/steamapps/shadercache ~/.cache/lutris ~/.cache/heroic ~/.cache/legendary ~/.cache/itch)
  local seen_paths="|"
  for p in "${paths[@]}"; do
    if [ -d "$p" ]; then
      local key
      key=$(path_key "$p")
      case "$seen_paths" in *"|$key|"*) continue ;; esac
      seen_paths="${seen_paths}${key}|"
      local sz
      sz=$(du -sh "$p" 2>/dev/null | cut -f1)
      printf '  %-30s %12s  →  %-12s\n' "$p" "${sz:-?}" "—"
    fi
  done
  printf '\n'
  c_info "Ejecutá clean --all para liberar espacio."
}

# ------------------------------------------------------------------ main
main() {
  [ $# -eq 0 ] && usage 1

  local do_temp=0 do_cache=0 do_logs=0 do_trash=0 do_thumbs=0 do_drives=0 do_browsers=0 do_ram=0 do_user_cache=0 do_dev=0 do_junk=0 do_wine=0 do_media=0 do_games=0 do_venv=0 do_apt_check=0 do_status=0 do_all=0

  while [ $# -gt 0 ]; do
    case "$1" in
      -a|--all)     do_temp=1; do_cache=1; do_logs=1; do_trash=1; do_thumbs=1; do_drives=1; do_browsers=1; do_ram=1; do_user_cache=1; do_dev=1; do_junk=1; do_wine=1; do_media=1; do_games=1; do_venv=1; do_all=1 ;;
      -t|--temp)    do_temp=1 ;;
      -c|--cache)   do_cache=1 ;;
      -l|--logs)    do_logs=1 ;;
      -T|--trash)   do_trash=1 ;;
      -m|--thumbs)  do_thumbs=1 ;;
      -b|--browsers) do_browsers=1 ;;
      -r|--ram)     do_ram=1 ;;
      -d|--drives)  do_drives=1 ;;
      -u|--user-cache) do_user_cache=1 ;;
      -D|--dev)     do_dev=1 ;;
      -j|--junk)    do_junk=1 ;;
      -w|--wine)    do_wine=1 ;;
      -M|--media)   do_media=1 ;;
      -g|--games)   do_games=1 ;;
      -V|--venv)    do_venv=1 ;;
      -K|--apt-check) do_apt_check=1 ;;
      -s|--status)  do_status=1 ;;
      -n|--dry-run) DRY_RUN=1 ;;
      -I|--interactive) INTERACTIVE=1 ;;
      -y|--yes)     NO_CONFIRM=1 ;;
      -h|--help)    usage 0 ;;
      *) c_err "Opción desconocida: $1"; usage 1 ;;
    esac
    shift
  done

  # --all activa automáticamente el modo interactivo (salvo que se use -y)
  if [ "$do_all" -eq 1 ] && [ "$NO_CONFIRM" -eq 0 ] && [ "$DRY_RUN" -eq 0 ]; then
    INTERACTIVE=1
  fi

  if [ $((do_temp+do_cache+do_logs+do_drives+do_ram+do_dev+do_junk+do_media)) -gt 0 ]; then
    need_root
  fi
  [ "$DRY_RUN" -eq 1 ] && c_warn "Modo simulación (dry-run): no se borrará nada."
  [ "$INTERACTIVE" -eq 1 ] && c_info "Modo interactivo: se pedirá confirmación antes de borrar."

  # --- fase de escaneo y confirmación ---
  if [ "$INTERACTIVE" -eq 1 ] && [ "$DRY_RUN" -eq 0 ]; then
    local divider="============================================"
    local hr="--------------------------------------------"
    local cache="${XDG_CACHE_HOME:-$HOME/.cache}"

    tui_header "CLEANER TUI 2026 -- Escaneo del sistema"

    local total_mb=0
    local scan_cache=0
    [ "$do_cache" -eq 1 ] || [ "$do_user_cache" -eq 1 ] && scan_cache=1
    local scan_total=$((do_temp+scan_cache+do_logs+do_trash+do_browsers+do_media+do_games+do_wine+do_dev+do_junk))
    local scan_current=0

    # --- TEMP ---
    if [ "$do_temp" -eq 1 ]; then
      scan_current=$((scan_current + 1)); tui_scan_step "$scan_current" "$scan_total" "Buscando temporales en /tmp y /var/tmp"
      printf '  \033[1;33m[ TEMP ]\033[0m Archivos temporales\n'
      for p in /tmp /var/tmp; do
        if [ -d "$p" ]; then
          local sz; sz=$(path_size "$p")
          local cnt; cnt=$(find "$p" -maxdepth 1 -mindepth 1 2>/dev/null | wc -l)
          printf '  %-48s %8s  %6s archivos\n' "$p" "$sz" "$cnt"
        fi
      done
      echo
    fi

    # --- CACHÉ ---
    if [ "$do_cache" -eq 1 ] || [ "$do_user_cache" -eq 1 ]; then
      scan_current=$((scan_current + 1)); tui_scan_step "$scan_current" "$scan_total" "Midiendo cachés de sistema y usuario"
      printf '  \033[1;33m[ CACHE ]\033[0m Cachés del sistema y usuario\n'
      [ -d /var/cache/apt ]   && printf '  %-48s %8s\n' "/var/cache/apt/archives"   "$(path_size /var/cache/apt/archives)"
      [ -d "$cache" ]         && printf '  %-48s %8s\n' "~/.cache" "$(path_size "$cache")"
      [ -d "$HOME/.nv" ]      && printf '  %-48s %8s  (NVIDIA)\n' "~/.nv" "$(path_size "$HOME/.nv")"
      [ -d "$HOME/.mesa_shader_cache" ] && printf '  %-48s %8s  (Mesa)\n' "~/.mesa_shader_cache" "$(path_size "$HOME/.mesa_shader_cache")"
      # Residual configs
      if command -v dpkg >/dev/null 2>&1; then
        local rc_count; rc_count=$(dpkg -l 2>/dev/null | awk '/^rc/' | wc -l)
        [ "${rc_count:-0}" -gt 0 ] && printf '  %-48s %8d  configs residuales\n' "paquetes en estado 'rc'" "$rc_count"
      fi
      echo
    fi

    # --- LOGS ---
    if [ "$do_logs" -eq 1 ]; then
      scan_current=$((scan_current + 1)); tui_scan_step "$scan_current" "$scan_total" "Revisando logs y coredumps"
      printf '  \033[1;33m[ LOGS ]\033[0m Registros del sistema\n'
      printf '  %-48s %8s\n' "/var/log" "$(path_size /var/log)"
      if [ -d /var/lib/systemd/coredump ]; then
        local cd; cd=$(find /var/lib/systemd/coredump -type f -size +0 2>/dev/null | wc -l)
        [ "$cd" -gt 0 ] && printf '  %-48s %8d  volcados\n' "/var/lib/systemd/coredump" "$cd"
      fi
      echo
    fi

    # --- TRASH ---
    if [ "$do_trash" -eq 1 ]; then
      scan_current=$((scan_current + 1)); tui_scan_step "$scan_current" "$scan_total" "Revisando papelera del usuario"
      printf '  \033[1;33m[ TRASH ]\033[0m Papelera del usuario\n'
      local trash="${XDG_DATA_HOME:-$HOME/.local/share}/Trash"
      if [ -d "$trash/files" ]; then
        local tc; tc=$(find "$trash/files" -type f 2>/dev/null | wc -l)
        printf '  %-48s %8s  %6d archivos\n' "$trash/files" "$(path_size "$trash/files")" "${tc:-0}"
      fi
      echo
    fi

    # --- BROWSERS ---
    if [ "$do_browsers" -eq 1 ]; then
      scan_current=$((scan_current + 1)); tui_scan_step "$scan_current" "$scan_total" "Detectando navegadores y cachés web"
      printf '  \033[1;33m[ BROWSERS ]\033[0m Caché de navegadores\n'
      # Contar rápido
      local cfgd="${XDG_CONFIG_HOME:-$HOME/.config}"
      local bc=0
      for bd in "$cfgd/google-chrome" "$cfgd/chromium" "$cfgd/BraveSoftware/Brave-Browser" "$cfgd/microsoft-edge" "$cfgd/opera" "$cfgd/vivaldi" "$HOME/.mozilla/firefox" "$HOME/.librewolf" "$HOME/.zen"; do
        [ -d "$bd" ] && bc=$((bc + 1))
      done
      [ "$bc" -gt 0 ] && printf '  %-48s %8d  navegadores\n' "detectados" "$bc"
      echo
    fi

    # --- MEDIA ---
    if [ "$do_media" -eq 1 ]; then
      scan_current=$((scan_current + 1)); tui_scan_step "$scan_current" "$scan_total" "Buscando residuos multimedia y edición"
      printf '  \033[1;33m[ MEDIA ]\033[0m Cachés multimedia\n'
      local cfgd="${XDG_CONFIG_HOME:-$HOME/.config}"
      local data="${XDG_DATA_HOME:-$HOME/.local/share}"
      local media_paths=(
        "$cache/vlc"
        "$cache/mpv"
        "$cache/gstreamer-1.0"
        "$cache/ffmpeg"
        "$cache/obs-studio"
        "$cfgd/obs-studio/logs"
        "$cache/kdenlive"
        "$data/kdenlive/proxy"
        "$cache/shotcut"
        "$cache/OpenShot"
        "$cache/openshot-qt"
        "$cache/pitivi"
        "$cache/HandBrake"
        "$cache/blender"
        "$cache/gimp"
        "$cache/krita"
        "$cache/inkscape"
        "$cache/darktable"
        "$cache/rawtherapee"
        "$cache/digikam"
        "$cache/shotwell"
        "$cache/gthumb"
        "$cache/nomacs"
        "$cache/pinta"
        "$cache/mypaint"
        "$cache/audacity"
        "$cfgd/audacity/SessionData"
        "$cache/ardour6"
        "$cache/ardour7"
        "$cache/ardour8"
        "$cache/lmms"
        "$cache/mixxx"
      )
      local mc=0
      local md
      local seen_paths="|"
      for md in "${media_paths[@]}" "$cfgd"/GIMP/*/tmp "$cfgd"/GIMP/*/templaterc.d "$cfgd"/RawTherapee*/cache "$cfgd"/darktable/cached_kernels_for_*; do
        [ -d "$md" ] || continue
        local key
        key=$(path_key "$md")
        case "$seen_paths" in *"|$key|"*) continue ;; esac
        seen_paths="${seen_paths}${key}|"
        mc=$((mc + 1))
        printf '  %-48s %8s\n' "$(echo "$md" | sed "s|$HOME|~|")" "$(path_size "$md")"
      done
      [ "$mc" -gt 0 ] || printf '  %-48s %8s\n' "(no se detectaron)" "—"
      echo
    fi

    # --- GAMES ---
    if [ "$do_games" -eq 1 ]; then
      scan_current=$((scan_current + 1)); tui_scan_step "$scan_current" "$scan_total" "Buscando cachés de juegos y launchers"
      printf '  \033[1;33m[ GAMES ]\033[0m Launchers y juegos\n'
      local cfgd="${XDG_CONFIG_HOME:-$HOME/.config}"
      local data="${XDG_DATA_HOME:-$HOME/.local/share}"
      local game_paths=(
        "$HOME/.steam/steam/appcache/httpcache"
        "$HOME/.steam/steam/config/htmlcache"
        "$HOME/.steam/steam/steamapps/shadercache"
        "$data/Steam/appcache/httpcache"
        "$data/Steam/config/htmlcache"
        "$data/Steam/steamapps/shadercache"
        "$cache/lutris"
        "$cache/heroic"
        "$cache/legendary"
        "$cache/itch"
        "$cache/bottles"
        "$cache/minigalaxy"
        "$cache/retroarch"
        "$cfgd/heroic/Cache"
        "$cfgd/itch/Cache"
        "$data/PrismLauncher/cache"
        "$HOME/.minecraft/logs"
        "$HOME/.minecraft/crash-reports"
      )
      local gc=0
      local gp
      local seen_paths="|"
      for gp in "${game_paths[@]}"; do
        [ -d "$gp" ] || continue
        local key
        key=$(path_key "$gp")
        case "$seen_paths" in *"|$key|"*) continue ;; esac
        seen_paths="${seen_paths}${key}|"
        gc=$((gc + 1))
        printf '  %-48s %8s\n' "$(echo "$gp" | sed "s|$HOME|~|")" "$(path_size "$gp")"
      done
      [ "$gc" -gt 0 ] || printf '  %-48s %8s\n' "(no se detectaron)" "—"
      echo
    fi

    # --- WINE ---
    if [ "$do_wine" -eq 1 ]; then
      scan_current=$((scan_current + 1)); tui_scan_step "$scan_current" "$scan_total" "Revisando temporales de Wine"
      printf '  \033[1;33m[ WINE ]\033[0m Basura de Wine\n'
      if [ -d "$HOME/.wine" ]; then
        local uname; uname=$(id -un 2>/dev/null || echo "$USER")
        for wp in "$HOME/.wine/drive_c/users/$uname/Temp" "$HOME/.wine/drive_c/users/$uname/AppData/Local/Temp" "$HOME/.wine/drive_c/windows/temp"; do
          [ -d "$wp" ] && printf '  %-48s %8s\n' "$(echo "$wp" | sed "s|$HOME|~|")" "$(path_size "$wp")"
        done
      else
        printf '  %-48s %8s\n' "(no se detectó Wine)" "—"
      fi
      echo
    fi

    # --- DEV ---
    if [ "$do_dev" -eq 1 ]; then
      scan_current=$((scan_current + 1)); tui_scan_step "$scan_current" "$scan_total" "Midiendo cachés de desarrollo"
      printf '  \033[1;33m[ DEV ]\033[0m Herramientas de desarrollo\n'
      [ -d "$HOME/.gradle/caches" ]    && printf '  %-48s %8s\n' "~/.gradle/caches"    "$(path_size "$HOME/.gradle/caches")"
      [ -d "$HOME/.npm/_cacache" ]     && printf '  %-48s %8s\n' "~/.npm/_cacache"     "$(path_size "$HOME/.npm/_cacache")"
      [ -d "$HOME/.cargo/registry" ]   && printf '  %-48s %8s\n' "~/.cargo/registry"   "$(path_size "$HOME/.cargo/registry")"
      echo
    fi

    # --- JUNK ---
    if [ "$do_junk" -eq 1 ]; then
      scan_current=$((scan_current + 1)); tui_scan_step "$scan_current" "$scan_total" "Buscando archivos basura seguros"
      printf '  \033[1;33m[ JUNK ]\033[0m Archivos basura\n'
      local jc=0
      jc=$(find /tmp /var/tmp "$HOME/Downloads" -maxdepth 3 -type f \( -name "*.swp" -o -name "*.bak" -o -name "*.old" -o -name "*.part" -o -name "*.crdownload" -o -name "*.tmp" -o -name "*.lock" \) 2>/dev/null | wc -l)
      printf '  %-48s %8d  archivos\n' "basura en /tmp, /var/tmp, ~/Downloads" "${jc:-0}"
      local pc; pc=$(find "$HOME" -maxdepth 6 -path '*/__pycache__' -type d 2>/dev/null | wc -l)
      [ "${pc:-0}" -gt 0 ] && printf '  %-48s %8d  directorios\n' "__pycache__ en ~/" "$pc"
      echo
    fi

    # --- RESUMEN ---
    local total_found=0
    # Aproximación rápida
    for p in /tmp /var/tmp /var/cache "$cache" "$HOME/.local/share/Trash" /var/log; do
      [ -d "$p" ] || continue
      local kb; kb=$(du -sk "$p" 2>/dev/null | awk '{print $1}')
      total_mb=$((total_mb + ${kb:-0} / 1024))
    done

    echo
    printf '  \033[1;36m%s\033[0m\n' "$hr"
    printf '  \033[1;37mTotal aproximado encontrado:\033[0m \033[1;33m%d MB\033[0m\n' "$total_mb"
    printf '  \033[1;36m%s\033[0m\n' "$hr"
    echo

    # --- LISTA DE TAREAS ---
    local task_list=""
    [ "$do_temp"    -eq 1 ] && task_list="$task_list Temp"
    [ "$do_cache"   -eq 1 ] && task_list="$task_list Cache"
    [ "$do_logs"    -eq 1 ] && task_list="$task_list Logs"
    [ "$do_trash"   -eq 1 ] && task_list="$task_list Trash"
    [ "$do_thumbs"  -eq 1 ] && task_list="$task_list Thumbs"
    [ "$do_browsers" -eq 1 ] && task_list="$task_list Browsers"
    [ "$do_ram"     -eq 1 ] && task_list="$task_list RAM"
    [ "$do_drives"  -eq 1 ] && task_list="$task_list Drives"
    [ "$do_user_cache" -eq 1 ] && task_list="$task_list UserCache"
    [ "$do_dev"     -eq 1 ] && task_list="$task_list Dev"
    [ "$do_junk"    -eq 1 ] && task_list="$task_list Junk"
    [ "$do_wine"    -eq 1 ] && task_list="$task_list Wine"
    [ "$do_media"   -eq 1 ] && task_list="$task_list Media"
    [ "$do_games"   -eq 1 ] && task_list="$task_list Games"
    c_info "Módulos a ejecutar:${task_list}"

    confirm_action "¿Ejecutar limpieza?"
  fi

  local before after
  before=$(df --output=used / 2>/dev/null | tail -1 || echo 0)

  TUI_TASK_TOTAL=$((do_temp+do_cache+do_logs+do_trash+do_thumbs+do_browsers+do_ram+do_drives+do_user_cache+do_dev+do_junk+do_wine+do_media+do_games))
  TUI_TASK_CURRENT=0
  if [ "$TUI_TASK_TOTAL" -gt 0 ]; then
    tui_header "CLEANER TUI 2026 -- Borrado y limpieza"
  fi

  [ "$do_temp"   -eq 1 ] && tui_run_task "Temp" "Eliminando temporales del sistema" clean_temp
  [ "$do_cache"  -eq 1 ] && tui_run_task "Cache" "Limpiando paquetes, huérfanos y /var/cache" clean_cache
  [ "$do_logs"   -eq 1 ] && tui_run_task "Logs" "Rotando journal y retirando logs viejos" clean_logs
  [ "$do_trash"  -eq 1 ] && tui_run_task "Trash" "Vaciando papelera del usuario" clean_trash
  [ "$do_thumbs" -eq 1 ] && tui_run_task "Thumbs" "Borrando miniaturas regenerables" clean_thumbs
  [ "$do_browsers" -eq 1 ] && tui_run_task "Browsers" "Limpiando cachés de navegadores" clean_browsers
  [ "$do_ram" -eq 1 ] && tui_run_task "RAM" "Liberando page cache y swap" clean_ram
  [ "$do_drives" -eq 1 ] && tui_run_task "Drives" "Limpiando papeleras de unidades montadas" clean_drives
  [ "$do_user_cache" -eq 1 ] && tui_run_task "UserCache" "Limpiando cachés de usuario y shaders" clean_user_cache
  [ "$do_dev" -eq 1 ] && tui_run_task "Dev" "Limpiando cachés de desarrollo" clean_dev
  [ "$do_junk" -eq 1 ] && tui_run_task "Junk" "Buscando y borrando basura segura" clean_junk
  [ "$do_wine" -eq 1 ] && tui_run_task "Wine" "Limpiando temporales de Wine y prefixes" clean_wine
  [ "$do_media" -eq 1 ] && tui_run_task "Media" "Limpiando multimedia, edición y fotografía" clean_media
  [ "$do_games" -eq 1 ] && tui_run_task "Games" "Limpiando cachés de juegos y launchers" clean_games
  [ "$do_venv" -eq 1 ] && tui_run_task "PythonVenv" "Limpiando entornos virtuales Python huérfanos" clean_venv
  [ "$do_apt_check" -eq 1 ] && tui_run_task "AptCheck" "Revisando fuentes APT con errores" clean_apt_check

  after=$(df --output=used / 2>/dev/null | tail -1 || echo 0)
  if [ "$DRY_RUN" -eq 0 ] && [ "$before" -gt "$after" ] 2>/dev/null; then
    local freed=$(( (before - after) / 1024 ))
    c_ok "Espacio liberado en /: ${freed} MB aprox."
  fi

  [ "$do_status" -eq 1 ] && clean_status

  # Registrar en historial solo si fue limpieza real
  if [ "$DRY_RUN" -eq 0 ] && [ $((do_temp+do_cache+do_logs+do_trash+do_thumbs+do_drives+do_browsers+do_ram+do_user_cache+do_dev+do_junk+do_wine+do_media+do_games)) -gt 0 ]; then
    local freed_mb=0
    if [ "$before" -gt "$after" ] 2>/dev/null; then
      freed_mb=$(( (before - after) / 1024 ))
    fi
    log_history "clean: ${freed_mb} MB liberados en / (tareas:${task_list:- varias})"
  fi

  c_ok "Limpieza finalizada."
}

main "$@"
