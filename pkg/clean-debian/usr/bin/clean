#!/usr/bin/env bash
#
# clean - Limpieza de archivos temporales y residuales en Debian
#
# Uso:
#   clean [opciones]
#
# Opciones:
#   -a, --all       Ejecuta todas las tareas de limpieza (sistema + unidades)
#   -t, --temp      Limpia archivos temporales (/tmp, /var/tmp)
#   -c, --cache     Limpia la caché de APT y paquetes huérfanos
#   -l, --logs      Vacía/rota los logs del sistema (journal + /var/log)
#   -T, --trash     Vacía la papelera del usuario
#   -m, --thumbs    Limpia miniaturas y cachés de usuario
#   -b, --browsers  Limpia la caché de los navegadores (Firefox, Chrome, etc.)
#   -r, --ram       Libera page/buffer cache y swap
#   -d, --drives    Limpia papeleras y temporales de unidades montadas
#   -u, --user-cache Limpia ~/.cache/ completo y ~/.nv/ (NVIDIA)
#   -D, --dev       Limpia cachés de desarrollo (.gradle, .npm, .cargo, pip, etc.)
#   -j, --junk      Busca y borra archivos basura seguros (*.swp, *.pyc, .DS_Store, etc.)
#   -w, --wine      Limpia temporales y cachés de Wine (~/.wine)
#   -M, --media     Limpia cachés multimedia (VLC, MPV, GStreamer, GIMP, etc.)
#   -s, --status    Muestra el uso de disco antes y después de la limpieza
#   -n, --dry-run   Muestra lo que se haría sin borrar nada
#   -I, --interactive Pide confirmación antes de borrar (automático con --all)
#   -y, --yes       Omite la confirmación interactiva (útil con --all)
#   -h, --help      Muestra esta ayuda
#
set -uo pipefail

DRY_RUN=0
INTERACTIVE=0
NO_CONFIRM=0
HISTFILE="${XDG_CACHE_HOME:-$HOME/.cache}/clean-history.log"
SUDO=""

# ------------------------------------------------------------------ helpers
c_info()  { printf '\033[1;34m[*]\033[0m %s\n' "$1"; }
c_ok()    { printf '\033[1;32m[+]\033[0m %s\n' "$1"; }
c_warn()  { printf '\033[1;33m[!]\033[0m %s\n' "$1"; }
c_err()   { printf '\033[1;31m[x]\033[0m %s\n' "$1" >&2; }

# Cabecera con barra azul para secciones
c_section() {
  local label="$1"
  local n=${#label}
  local fill=$(( (50 - n - 2) / 2 ))
  local remain=$(( 50 - n - fill - 2 ))
  printf '\n \033[1;37;44m%*s\033[22;0m' "$fill" ""
  printf '\033[1;37;44m %s \033[22;0m' "$label"
  printf '\033[1;37;44m%*s\033[0m\n' "$remain" ""
}

# Spinner unicode
SPIN=( '⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏' )

run_spin() {
  local msg="$1" cmd="$2"
  if [ "$DRY_RUN" -eq 1 ]; then
    printf '    \033[2m(dry-run)\033[0m %s\n' "$cmd"
    return 0
  fi
  eval "$cmd" &
  local pid=$! i=0
  while kill -0 "$pid" 2>/dev/null; do
    printf "\r    \033[1;34m${SPIN[$i]}\033[0m %s" "$msg"
    i=$(( (i + 1) % ${#SPIN[@]} ))
    sleep 0.1
  done
  wait "$pid"
  local rc=$?
  if [ $rc -eq 0 ]; then
    printf "\r    \033[1;32m✓\033[0m %s\n" "$msg"
  else
    printf "\r    \033[1;33m!\033[0m %s (código $rc)\n" "$msg"
  fi
  return $rc
}

log_history() {
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >> "$HISTFILE"
}

confirm_action() {
  if [ "$NO_CONFIRM" -eq 1 ]; then
    return 0
  fi
  if [ "$INTERACTIVE" -eq 0 ]; then
    return 0
  fi
  local msg="${1:-¿Continuar con la limpieza?}"
  local answer
  read -r -p "$msg (s/N): " answer
  case "$answer" in
    [sS]|[sS][iIíÍ]) return 0 ;;
    *) c_warn "Cancelado por el usuario."; exit 0 ;;
  esac
}

need_root() {
  if [ "$(id -u)" -ne 0 ]; then
    if command -v sudo >/dev/null 2>&1; then
      SUDO="sudo"
    else
      c_err "Se requieren privilegios de root para algunas tareas."
      exit 1
    fi
  fi
}

# Ejecuta un comando respetando el modo dry-run
run() {
  if [ "$DRY_RUN" -eq 1 ]; then
    printf '    \033[2m(dry-run)\033[0m %s\n' "$*"
  else
    eval "$@"
  fi
}

usage() {
  cat <<'EOF'

clean - Limpieza de archivos temporales y residuales en Debian

Uso:
  clean [opciones]

Opciones:
  -a, --all       Ejecuta todas las tareas de limpieza (sistema + unidades)
  -t, --temp      Limpia archivos temporales (/tmp, /var/tmp)
  -c, --cache     Limpia la caché de APT y paquetes huérfanos
  -l, --logs      Vacía/rota los logs del sistema (journal + /var/log)
  -T, --trash     Vacía la papelera del usuario
  -m, --thumbs    Limpia miniaturas y cachés de usuario
  -b, --browsers  Limpia la caché de los navegadores (Firefox, Chrome, etc.)
  -r, --ram       Libera page/buffer cache del kernel y swap
  -d, --drives    Limpia papeleras y temporales de unidades montadas
  -u, --user-cache Limpia ~/.cache/ completo y ~/.nv/ (NVIDIA)
  -D, --dev       Limpia cachés de desarrollo (.gradle, .npm, .cargo, pip, etc.)
  -j, --junk      Busca y borra archivos basura seguros (*.swp, *.pyc, .DS_Store, etc.)
  -w, --wine      Limpia temporales y cachés de Wine (~/.wine)
  -M, --media     Limpia cachés multimedia (VLC, MPV, GStreamer, GIMP, etc.)
  -s, --status    Muestra el uso de disco antes y después de la limpieza
  -n, --dry-run   Muestra lo que se haría sin borrar nada
  -I, --interactive Pide confirmación antes de borrar (automático con --all)
  -y, --yes       Omite la confirmación interactiva (útil con --all)
  -h, --help      Muestra esta ayuda
EOF
  exit "${1:-0}"
}

# Tamaño legible de una ruta (0 si no existe)
path_size() {
  du -sh "$1" 2>/dev/null | awk '{print $1; exit}'
}

# ------------------------------------------------------------------ tareas
clean_temp() {
  c_info "Limpiando archivos temporales..."
  for dir in /tmp /var/tmp; do
    [ -d "$dir" ] || continue
    run "$SUDO find '$dir' -mindepth 1 -maxdepth 1 ! -name 'systemd-*' ! -name '.X11-unix' ! -name '.ICE-unix' -exec rm -rf {} + 2>/dev/null"
  done
  c_ok "Temporales limpiados."
}

clean_cache() {
  c_section "CACHÉ DE PAQUETES"

  # Detectar el gestor de paquetes disponible
  if command -v apt-get >/dev/null 2>&1; then
    c_info "  Gestor: APT (Debian/Ubuntu)"
    run_spin "  Limpiando caché APT..." "$SUDO apt-get clean -y"
    run_spin "  Auto-limpieza APT..." "$SUDO apt-get autoclean -y"
    run_spin "  Removiendo huérfanos..." "$SUDO apt-get autoremove --purge -y"
    run "$SUDO find /var/cache/apt/archives -maxdepth 1 -type f -name '*.deb' -delete 2>/dev/null"

    # Purga configuraciones residuales (estado 'rc')
    if command -v dpkg >/dev/null 2>&1; then
      local residual
      residual=$(dpkg -l 2>/dev/null | awk '/^rc/{print $2}' | tr '\n' ' ')
      if [ -n "${residual// /}" ]; then
        c_info "Configuraciones residuales detectadas: $residual"
        run "$SUDO apt-get purge -y $residual"
      else
        c_info "Sin configuraciones residuales."
      fi
    fi

  elif command -v dnf >/dev/null 2>&1; then
    c_info "  Gestor: DNF (Fedora/RHEL)"
    run "$SUDO dnf clean all -y"
    run "$SUDO dnf autoremove -y"

  elif command -v pacman >/dev/null 2>&1; then
    c_info "  Gestor: Pacman (Arch)"
    run "$SUDO pacman -Sc --noconfirm 2>/dev/null"
    # Limpiar metadatos de sincronización
    [ -d "$HOME/.cache/pacman" ] && run "rm -rf '$HOME/.cache/pacman/'* 2>/dev/null"

  elif command -v emerge >/dev/null 2>&1; then
    c_info "  Gestor: Portage (Gentoo)"
    [ -d /var/tmp/portage ] && run "$SUDO rm -rf /var/tmp/portage/* 2>/dev/null"

  else
    c_warn "Sin gestor de paquetes reconocido, se omite limpieza de paquetes."
  fi

  # Limpieza segura de /var/cache (cachés regenerables, común a todas las distros)
  c_info "Limpiando cachés seguras de /var/cache..."
  [ -d /var/cache/fontconfig ] && run "$SUDO rm -rf /var/cache/fontconfig/* 2>/dev/null"
  [ -d /var/cache/man ]        && run "$SUDO rm -rf /var/cache/man/* 2>/dev/null"
  [ -d /var/cache/thumbnails ] && run "$SUDO rm -rf /var/cache/thumbnails/* 2>/dev/null"

  c_ok "Caché de paquetes limpiada."
}

clean_logs() {
  c_section "LOGS DEL SISTEMA"
  if command -v journalctl >/dev/null 2>&1; then
    run_spin "  Rotando journal..." "$SUDO journalctl --rotate"
    run_spin "  Compactando journal (3d)..." "$SUDO journalctl --vacuum-time=3d"
  fi
  run "$SUDO find /var/log -type f -name '*.gz' -delete 2>/dev/null"
  run "$SUDO find /var/log -type f -regextype posix-extended -regex '.*\.[0-9]+$' -delete 2>/dev/null"
  # Coredumps de systemd (volcados de memoria)
  if [ -d /var/lib/systemd/coredump ]; then
    local cdump
    cdump=$(find /var/lib/systemd/coredump -type f -size +0 2>/dev/null | wc -l)
    if [ "$cdump" -gt 0 ]; then
      c_info "Eliminando ${cdump} volcado(s) de memoria (coredump)..."
      run "$SUDO rm -rf /var/lib/systemd/coredump/* 2>/dev/null"
    fi
  fi
  c_ok "Logs limpiados."
}

clean_trash() {
  c_info "Vaciando papelera del usuario..."
  local trash="${XDG_DATA_HOME:-$HOME/.local/share}/Trash"
  if [ -d "$trash" ]; then
    run "rm -rf '$trash/files/'* '$trash/info/'* 2>/dev/null"
  fi
  c_ok "Papelera vaciada."
}

clean_thumbs() {
  c_info "Limpiando miniaturas y cachés de usuario..."
  local cache="${XDG_CACHE_HOME:-$HOME/.cache}"
  [ -d "$cache/thumbnails" ] && run "rm -rf '$cache/thumbnails/'* 2>/dev/null"
  [ -d "$HOME/.thumbnails" ]  && run "rm -rf '$HOME/.thumbnails/'* 2>/dev/null"
  c_ok "Miniaturas limpiadas."
}

clean_browsers() {
  c_section "CACHÉ DE NAVEGADORES"
  local cache="${XDG_CACHE_HOME:-$HOME/.cache}"
  local cfg="${XDG_CONFIG_HOME:-$HOME/.config}"

  # Mapa de procesos para detectar navegadores abiertos
  local browsers_procs="firefox firefox-esr firefox-bin chrome chromium chromium-browser brave brave-browser opera vivaldi-bin microsoft-edge msedge librewolf floorp waterfox tor-browser palemoon basilisk falkon qutebrowser midori epiphany zen"
  local open=""
  local b
  for b in $browsers_procs; do
    if pgrep -x -u "$(id -u)" "$b" >/dev/null 2>&1; then
      open="$open $b"
    fi
  done
  if [ -n "$open" ] && [ "$DRY_RUN" -eq 0 ]; then
    c_warn "Navegadores abiertos:$open (ciérralos para una limpieza completa)."
  fi

  # ---- Navegadores (nombre → directorio de config) ----
  # Cada entrada: "Label|ruta_config"
  declare -A BROWSERS=()

  # Chromium / Blink
  BROWSERS["Google Chrome"]="$cfg/google-chrome"
  BROWSERS["Chromium"]="$cfg/chromium"
  BROWSERS["Brave"]="$cfg/BraveSoftware/Brave-Browser"
  BROWSERS["Microsoft Edge"]="$cfg/microsoft-edge"
  BROWSERS["Opera"]="$cfg/opera"
  BROWSERS["Vivaldi"]="$cfg/vivaldi"
  BROWSERS["qutebrowser"]="$cfg/qutebrowser"
  BROWSERS["Falkon"]="$cfg/falkon"
  BROWSERS["Midori"]="$cfg/midori"
  BROWSERS["Iridium"]="$cfg/iridium"
  BROWSERS["Slimjet"]="$cfg/slimjet"
  BROWSERS["Dissenter"]="$cfg/dissenter"
  BROWSERS["Epiphany (GNOME Web)"]="$cfg/epiphany"
  BROWSERS["Ghostery"]="$cfg/Ghostery"

  # Firefox / Gecko
  BROWSERS["Firefox"]="$HOME/.mozilla/firefox"
  BROWSERS["LibreWolf"]="$HOME/.librewolf"
  BROWSERS["Floorp"]="$HOME/.floorp"
  BROWSERS["Waterfox"]="$HOME/.waterfox"
  BROWSERS["Zen Browser"]="$HOME/.zen"
  BROWSERS["Pale Moon"]="$HOME/.moonchild productions/pale moon"
  BROWSERS["Basilisk"]="$HOME/.moonchild productions/basilisk"
  BROWSERS["Tor Browser"]="$HOME/.tor-browser"

  # Primero contar cuántos navegadores hay instalados
  local total=0 current=0
  for name in "${!BROWSERS[@]}"; do
    [ -d "${BROWSERS[$name]}" ] && total=$((total + 1))
  done
  if [ "$total" -eq 0 ]; then
    c_info "  No se detectaron navegadores instalados."
    c_ok "Caché de navegadores limpiada."
    return
  fi

  for name in "${!BROWSERS[@]}"; do
    local base="${BROWSERS[$name]}"
    [ -d "$base" ] || continue
    current=$((current + 1))

    local prefix
    prefix=$(printf '  \033[1;34m[%d/%d]\033[0m %s' "$current" "$total" "$name")

    case "$name" in
      # ---- Navegadores basados en Chromium/Blink ----
      "Google Chrome"|"Chromium"|"Brave"|"Microsoft Edge"|"Opera"|"Vivaldi"|"Falkon"|"Midori"|"Iridium"|"Slimjet"|"Dissenter"|"Ghostery")
        printf '%s\n' "$prefix"
        run "rm -rf '$base'/*/Cache/* '$base'/*/'Code Cache'/* '$base'/*/GPUCache/* '$base'/*/ShaderCache/* 2>/dev/null"
        ;;

      # ---- qutebrowser (cache separado en ~/.cache) ----
      "qutebrowser")
        printf '%s\n' "$prefix"
        run "rm -rf '$cache/qutebrowser/'* '$base/'*/webengine/Cache/* 2>/dev/null"
        ;;

      # ---- Epiphany (GNOME Web / WebKit) ----
      "Epiphany (GNOME Web)")
        printf '%s\n' "$prefix"
        run "rm -rf '$cache/epiphany/'* 2>/dev/null"
        ;;

      # ---- Navegadores basados en Firefox / Gecko ----
      *)
        printf '%s\n' "$prefix"
        run "rm -rf '$base/'*/cache2/* '$base/'*/startupCache/* '$base/'*/thumbnails/* 2>/dev/null"
        ;; 
    esac
  done

  # Cachés adicionales en ~/.cache (Chromium-based que guardan cache acá)
  for d in google-chrome chromium BraveSoftware opera vivaldi microsoft-edge falkon midori iridium slimjet epiphany; do
    if [ -d "$cache/$d" ] && [ -n "$(ls -A "$cache/$d" 2>/dev/null)" ]; then
      c_info "  ~/.cache/$d"
      run "rm -rf '$cache/$d/'* 2>/dev/null"
    fi
  done

  c_ok "Caché de navegadores limpiada (${total} encontrados)."
}

clean_ram() {
  c_info "Liberando caché del kernel (page/buffer cache) en RAM..."
  if [ "$DRY_RUN" -eq 0 ] && command -v free >/dev/null 2>&1; then
    c_info "  Antes: $(free -h | awk '/Mem:/{print "usada "$3", cache "$6}')"
  fi
  run "sync"
  run "$SUDO sh -c 'echo 3 > /proc/sys/vm/drop_caches'"
  if [ "$DRY_RUN" -eq 0 ] && command -v free >/dev/null 2>&1; then
    c_info "  Después: $(free -h | awk '/Mem:/{print "usada "$3", cache "$6}')"
  fi
  c_ok "Caché de RAM liberada (no se borraron datos)."

  # Limpiar swap (manda todo de vuelta a RAM si hay espacio)
  if command -v swapon >/dev/null 2>&1; then
    local swaps
    swaps=$(swapon --show=NAME --noheadings 2>/dev/null | wc -l)
    if [ "$swaps" -gt 0 ]; then
      c_info "Vaciando swap (swapoff/on)..."
      if [ "$DRY_RUN" -eq 0 ]; then
        $SUDO swapoff -a 2>/dev/null && $SUDO swapon -a 2>/dev/null || c_warn "No se pudo vaciar el swap (RAM insuficiente?)."
      else
        printf '    \033[2m(dry-run)\033[0m sudo swapoff -a && sudo swapon -a\n'
      fi
    fi
  fi
  c_ok "RAM y swap limpiados."
}

clean_drives() {
  c_info "Limpiando unidades montadas (papeleras y temporales)..."
  local mounts
  mounts=$(findmnt -rn -o TARGET -t vfat,exfat,ntfs,ext4,ext3,ext2,btrfs,xfs 2>/dev/null \
            | grep -E '^/(media|mnt|run/media|home)/' || true)
  if [ -z "$mounts" ]; then
    c_warn "No se detectaron unidades montadas en /media, /mnt, /run/media o /home."
    return
  fi
  local drive_total=0 drive_cur=0
  while IFS= read -r mp2; do [ -n "$mp2" ] && [ "$mp2" != "$HOME" ] && drive_total=$((drive_total + 1)); done <<< "$mounts"
  if [ "$drive_total" -eq 0 ]; then return; fi
  while IFS= read -r mp; do
    [ -z "$mp" ] && continue
    [ "$mp" = "$HOME" ] && continue
    drive_cur=$((drive_cur + 1))
    printf '  \033[1;34m[%d/%d]\033[0m Unidad: %s\n' "$drive_cur" "$drive_total" "$mp"
    run "$SUDO find '$mp' -maxdepth 3 -type d -name '.Trash-*' -exec rm -rf {} + 2>/dev/null"
    run "$SUDO find '$mp' -maxdepth 3 -type d -iname '\$RECYCLE.BIN' -exec rm -rf {} + 2>/dev/null"
    run "$SUDO find '$mp' -maxdepth 2 -type f -name 'Thumbs.db' -delete 2>/dev/null"
    run "$SUDO find '$mp' -maxdepth 2 -type f -name '.DS_Store' -delete 2>/dev/null"
  done <<< "$mounts"
  c_ok "Unidades limpiadas."
}

clean_user_cache() {
  c_info "Limpiando caché completo de usuario (~/.cache)..."
  local cache="${XDG_CACHE_HOME:-$HOME/.cache}"
  if [ -d "$cache" ]; then
    local before
    before=$(path_size "$cache")
    # Borra todo ~/.cache excepto el propio script de limpieza
    run "find '$cache' -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null"
    local after
    after=$(path_size "$cache")
    c_info "  Antes: ${before:-?}  Después: ${after:-?}"
  fi

  # NVIDIA shader cache
  if [ -d "$HOME/.nv" ]; then
    local nv_size
    nv_size=$(path_size "$HOME/.nv")
    c_info "Limpiando caché NVIDIA (~/.nv): ${nv_size:-?}"
    run "rm -rf '$HOME/.nv/'* 2>/dev/null"
  fi
  # Mesa (OpenGL/Vulkan) shader cache
  if [ -d "$HOME/.mesa_shader_cache" ]; then
    local mesa_size
    mesa_size=$(path_size "$HOME/.mesa_shader_cache")
    c_info "Limpiando Mesa shader cache (~/.mesa_shader_cache): ${mesa_size:-?}"
    run "rm -rf '$HOME/.mesa_shader_cache/'* 2>/dev/null"
  fi
  c_ok "Caché de usuario limpiada."
}

clean_dev() {
  c_info "Limpiando cachés de herramientas de desarrollo..."
  local found=0

  # Gradle
  if [ -d "$HOME/.gradle/caches" ]; then
    c_info "  Gradle"
    run "rm -rf '$HOME/.gradle/caches/'* 2>/dev/null"
    found=1
  fi
  # npm
  if [ -d "$HOME/.npm/_cacache" ]; then
    c_info "  npm"
    run "rm -rf '$HOME/.npm/_cacache/'* 2>/dev/null"
    found=1
  fi
  # Cargo (Rust)
  if [ -d "$HOME/.cargo/registry/cache" ]; then
    c_info "  Cargo"
    run "rm -rf '$HOME/.cargo/registry/cache/'* 2>/dev/null"
    found=1
  fi
  # pip (Python)
  local pip_cache="${XDG_CACHE_HOME:-$HOME/.cache}/pip"
  if [ -d "$pip_cache" ]; then
    c_info "  pip"
    run "rm -rf '$pip_cache/'* 2>/dev/null"
    found=1
  fi
  # Yarn
  if [ -d "$HOME/.yarn/cache" ]; then
    c_info "  Yarn"
    run "rm -rf '$HOME/.yarn/cache/'* 2>/dev/null"
    found=1
  fi
  # Maven (~/.m2/repository)
  if [ -d "$HOME/.m2/repository" ]; then
    c_info "  Maven (se omite ~/.m2/repository completo, solo descargas parciales)"
    run "find '$HOME/.m2/repository' -type f -name '*.jar' -size 0 -delete 2>/dev/null"
    run "find '$HOME/.m2/repository' -type f -name '*.lastUpdated' -delete 2>/dev/null"
    found=1
  fi
  # Go module cache
  if [ -d "$HOME/go/pkg/mod/cache" ]; then
    c_info "  Go modules"
    run "rm -rf '$HOME/go/pkg/mod/cache/'* 2>/dev/null"
    found=1
  fi
  # node_modules/.cache (webpack, babel, etc.)
  if [ -n "$(find "$HOME" -maxdepth 5 -path '*/node_modules/.cache' -type d -print -quit 2>/dev/null)" ]; then
    c_info "  node_modules/.cache"
    run "find '$HOME' -maxdepth 5 -path '*/node_modules/.cache' -type d -exec rm -rf {} + 2>/dev/null"
    found=1
  fi

  if [ "$found" -eq 0 ]; then
    c_info "  No se detectaron herramientas de desarrollo con caché."
  fi
  c_ok "Cachés de desarrollo limpiadas."
}

clean_wine() {
  c_info "Limpiando temporales y cachés de Wine..."
  local wine_dir="$HOME/.wine"
  if [ ! -d "$wine_dir" ]; then
    c_info "  Wine no está instalado (no existe ~/.wine)."
    return
  fi

  local user_name
  user_name=$(id -un 2>/dev/null || echo "$USER")

  local paths=(
    "$wine_dir/drive_c/users/$user_name/Temp"
    "$wine_dir/drive_c/users/$user_name/AppData/Local/Temp"
    "$wine_dir/drive_c/users/$user_name/AppData/Local/Microsoft/Windows/INetCache"
    "$wine_dir/drive_c/users/$user_name/AppData/Local/CrashDumps"
    "$wine_dir/drive_c/windows/temp"
  )

  local found=0
  for p in "${paths[@]}"; do
    if [ -d "$p" ]; then
      found=1
      c_info "  $(echo "$p" | sed "s|$wine_dir|~/.wine|")"
      run "rm -rf '$p/'* 2>/dev/null"
    fi
  done

  # También buscar en otros prefixes de Wine (Lutris, PlayOnLinux, etc.)
  for prefix in "$HOME/.wine" "$HOME/Games" "$HOME/.PlayOnLinux/wineprefix" "$HOME/.local/share/lutris" "$HOME/.local/share/bottles"; do
    if [ -d "$prefix" ]; then
      c_info "  Buscando temporales en $prefix..."
      run "find '$prefix' -maxdepth 5 -type d \( -name 'Temp' -o -name 'INetCache' -o -name 'CrashDumps' \) -exec rm -rf {}/'*' \; 2>/dev/null"
      found=1
    fi
  done

  if [ "$found" -eq 0 ]; then
    c_info "  No se encontraron temporales de Wine."
  fi
  c_ok "Temporales de Wine limpiados."
}

clean_media() {
  c_section "CACHÉ MULTIMEDIA"

  local found=0
  local cache="${XDG_CACHE_HOME:-$HOME/.cache}"
  local data="${XDG_DATA_HOME:-$HOME/.local/share}"

  # ── Audio ──
  # PulseAudio (solo si no está corriendo)
  if pgrep -x pulseaudio >/dev/null 2>&1; then
    c_warn "  PulseAudio está corriendo; se omiten sus cachés para no interrumpir el audio."
  else
    if [ -d "$cache/pulse" ]; then
      c_info "  PulseAudio"
      run "rm -rf '$cache/pulse/'* 2>/dev/null"
      found=1
    fi
  fi
  # PipeWire (solo si no está corriendo)
  if pgrep -x pipewire >/dev/null 2>&1; then
    c_warn "  PipeWire está corriendo; se omiten sus cachés."
  else
    if [ -d "$cache/pipewire" ]; then
      c_info "  PipeWire"
      run "rm -rf '$cache/pipewire/'* 2>/dev/null"
      found=1
    fi
  fi

  # ── Video ──
  local video_dirs=(
    "$cache/gstreamer-1.0"
    "$cache/vlc"
    "$cache/mpv"
    "$cache/ffmpeg"
    "$cache/obs-studio"
    "$data/vlc"
  )
  for d in "${video_dirs[@]}"; do
    if [ -d "$d" ]; then
      found=1
      local label
      label=$(echo "$d" | sed "s|$HOME|~|")
      c_info "  $label"
      run "rm -rf '$d/'* 2>/dev/null"
    fi
  done

  # ── Imágenes ──
  local image_dirs=(
    "$cache/eog"
    "$cache/gimp"
    "$cache/krita"
    "$cache/inkscape"
    "$cache/darktable"
    "$cache/rawtherapee"
    "$data/gimp"
  )
  for d in "${image_dirs[@]}"; do
    if [ -d "$d" ]; then
      found=1
      local label
      label=$(echo "$d" | sed "s|$HOME|~|")
      c_info "  $label"
      run "rm -rf '$d/'* 2>/dev/null"
    fi
  done

  # ── Reproductores de música ──
  local music_dirs=(
    "$data/rhythmbox"
    "$data/audacious"
    "$data/clementine"
    "$data/deadbeef"
  )
  for d in "${music_dirs[@]}"; do
    if [ -d "$d" ]; then
      found=1
      local label
      label=$(echo "$d" | sed "s|$HOME|~|")
      c_info "  $label"
      run "rm -rf '$d/'* 2>/dev/null"
    fi
  done

  # ── Display managers (solo si no hay sesión gráfica activa) ──
  if [ -z "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ]; then
    for dm in /var/cache/lightdm /var/cache/sddm /var/cache/gdm; do
      if [ -d "$dm" ]; then
        c_info "  $dm"
        run "$SUDO rm -rf '$dm/'* 2>/dev/null"
        found=1
      fi
    done
  fi

  if [ "$found" -eq 0 ]; then
    c_info "  No se detectaron cachés multimedia."
  else
    c_info "  $found categoría(s) multimedia limpiada(s)."
  fi
  c_ok "Caché multimedia limpiada."
}

clean_junk() {
  c_info "Buscando y limpiando archivos basura seguros..."
  local search_dirs=(
    /tmp /var/tmp "$HOME/Downloads" "$HOME/Desktop" "$HOME/Documentos" "$HOME/Documents" "$HOME/Escritorio"
  )
  local total=0

  # Patrones seguros de borrar
  local patterns=(-name "*.swp" -o -name "*.swo" -o -name "*.bak" -o -name "*.old" -o -name "*.part" -o -name "*.crdownload" -o -name "*.unfinished" -o -name "*.tmp" -o -name "*.temp" -o -name "*.lock")

  for dir in "${search_dirs[@]}"; do
    [ -d "$dir" ] || continue
    local count
    count=$(find "$dir" -maxdepth 3 -type f \( "${patterns[@]}" \) 2>/dev/null | wc -l)
    if [ "$count" -gt 0 ]; then
      c_info "  $dir: ${count} archivo(s)"
      run "find '$dir' -maxdepth 3 -type f \( ${patterns[*]} \) -delete 2>/dev/null"
      total=$((total + count))
    fi
  done

  # Archivos vacíos (0 KB) en /tmp, /var/tmp, ~/Downloads
  for dir in /tmp /var/tmp "$HOME/Downloads"; do
    [ -d "$dir" ] || continue
    local empty
    empty=$(find "$dir" -maxdepth 3 -type f -size 0 2>/dev/null | wc -l)
    if [ "$empty" -gt 0 ]; then
      c_info "  $dir: ${empty} archivo(s) vacío(s)"
      run "find '$dir' -maxdepth 3 -type f -size 0 -delete 2>/dev/null"
      total=$((total + empty))
    fi
  done

  # __pycache__ en home (bytecode de Python, se regenera solo)
  if [ -d "$HOME" ]; then
    local pycache
    pycache=$(find "$HOME" -maxdepth 6 -path '*/__pycache__' -type d 2>/dev/null | wc -l)
    if [ "$pycache" -gt 0 ]; then
      c_info "  __pycache__/: ${pycache} directorio(s) en ~/"
      run "find '$HOME' -maxdepth 6 -path '*/__pycache__' -type d -exec rm -rf {} + 2>/dev/null"
    fi
  fi

  if [ "$total" -eq 0 ] && [ "${pycache:-0}" -eq 0 ]; then
    c_info "  No se encontró basura."
  else
    c_info "  Total eliminado: ${total} archivos basura + ${pycache:-0} __pycache__"
  fi
  c_ok "Basura limpiada."
}

clean_status() {
  c_info "Uso de disco antes/después:"
  printf '\n'
  printf '  %-30s %12s  →  %-12s\n' "RUTA" "ANTES" "AHORA"
  printf '  %-30s %12s  →  %-12s\n' "---" "-----" "----"

  local paths=(/tmp /var/tmp /var/cache ~/.cache ~/.local/share/Trash ~/.nv /var/log)
  for p in "${paths[@]}"; do
    if [ -d "$p" ]; then
      local sz
      sz=$(du -sh "$p" 2>/dev/null | cut -f1)
      printf '  %-30s %12s  →  %-12s\n' "$p" "${sz:-?}" "—"
    fi
  done
  printf '\n'
  c_info "Ejecutá clean --all para liberar espacio."
}

# ------------------------------------------------------------------ main
main() {
  [ $# -eq 0 ] && usage 1

  local do_temp=0 do_cache=0 do_logs=0 do_trash=0 do_thumbs=0 do_drives=0 do_browsers=0 do_ram=0 do_user_cache=0 do_dev=0 do_junk=0 do_wine=0 do_media=0 do_status=0 do_all=0

  while [ $# -gt 0 ]; do
    case "$1" in
      -a|--all)     do_temp=1; do_cache=1; do_logs=1; do_trash=1; do_thumbs=1; do_drives=1; do_browsers=1; do_ram=1; do_user_cache=1; do_dev=1; do_junk=1; do_wine=1; do_media=1; do_all=1 ;;
      -t|--temp)    do_temp=1 ;;
      -c|--cache)   do_cache=1 ;;
      -l|--logs)    do_logs=1 ;;
      -T|--trash)   do_trash=1 ;;
      -m|--thumbs)  do_thumbs=1 ;;
      -b|--browsers) do_browsers=1 ;;
      -r|--ram)     do_ram=1 ;;
      -d|--drives)  do_drives=1 ;;
      -u|--user-cache) do_user_cache=1 ;;
      -D|--dev)     do_dev=1 ;;
      -j|--junk)    do_junk=1 ;;
      -w|--wine)    do_wine=1 ;;
      -M|--media)   do_media=1 ;;
      -s|--status)  do_status=1 ;;
      -n|--dry-run) DRY_RUN=1 ;;
      -I|--interactive) INTERACTIVE=1 ;;
      -y|--yes)     NO_CONFIRM=1 ;;
      -h|--help)    usage 0 ;;
      *) c_err "Opción desconocida: $1"; usage 1 ;;
    esac
    shift
  done

  # --all activa automáticamente el modo interactivo (salvo que se use -y)
  if [ "$do_all" -eq 1 ] && [ "$NO_CONFIRM" -eq 0 ] && [ "$DRY_RUN" -eq 0 ]; then
    INTERACTIVE=1
  fi

  if [ $((do_temp+do_cache+do_logs+do_drives+do_ram+do_dev+do_junk+do_media)) -gt 0 ]; then
    need_root
  fi
  [ "$DRY_RUN" -eq 1 ] && c_warn "Modo simulación (dry-run): no se borrará nada."
  [ "$INTERACTIVE" -eq 1 ] && c_info "Modo interactivo: se pedirá confirmación antes de borrar."

  # --- fase de escaneo y confirmación ---
  if [ "$INTERACTIVE" -eq 1 ] && [ "$DRY_RUN" -eq 0 ]; then
    local divider="============================================"
    local hr="--------------------------------------------"
    local cache="${XDG_CACHE_HOME:-$HOME/.cache}"

    echo
    printf '  \033[1;36m%s\033[0m\n' "$divider"
    printf '  \033[1;37;46m   CLEANER -- Escaneo del sistema   \033[0m\n'
    printf '  \033[1;36m%s\033[0m\n' "$divider"
    echo

    local total_mb=0

    # --- TEMP ---
    if [ "$do_temp" -eq 1 ]; then
      printf '  \033[1;33m[ TEMP ]\033[0m Archivos temporales\n'
      for p in /tmp /var/tmp; do
        if [ -d "$p" ]; then
          local sz; sz=$(path_size "$p")
          local cnt; cnt=$(find "$p" -maxdepth 1 -mindepth 1 2>/dev/null | wc -l)
          printf '  %-48s %8s  %6s archivos\n' "$p" "$sz" "$cnt"
        fi
      done
      echo
    fi

    # --- CACHÉ ---
    if [ "$do_cache" -eq 1 ] || [ "$do_user_cache" -eq 1 ]; then
      printf '  \033[1;33m[ CACHE ]\033[0m Cachés del sistema y usuario\n'
      [ -d /var/cache/apt ]   && printf '  %-48s %8s\n' "/var/cache/apt/archives"   "$(path_size /var/cache/apt/archives)"
      [ -d "$cache" ]         && printf '  %-48s %8s\n' "~/.cache" "$(path_size "$cache")"
      [ -d "$HOME/.nv" ]      && printf '  %-48s %8s  (NVIDIA)\n' "~/.nv" "$(path_size "$HOME/.nv")"
      [ -d "$HOME/.mesa_shader_cache" ] && printf '  %-48s %8s  (Mesa)\n' "~/.mesa_shader_cache" "$(path_size "$HOME/.mesa_shader_cache")"
      # Residual configs
      if command -v dpkg >/dev/null 2>&1; then
        local rc_count; rc_count=$(dpkg -l 2>/dev/null | awk '/^rc/' | wc -l)
        [ "${rc_count:-0}" -gt 0 ] && printf '  %-48s %8d  configs residuales\n' "paquetes en estado 'rc'" "$rc_count"
      fi
      echo
    fi

    # --- LOGS ---
    if [ "$do_logs" -eq 1 ]; then
      printf '  \033[1;33m[ LOGS ]\033[0m Registros del sistema\n'
      printf '  %-48s %8s\n' "/var/log" "$(path_size /var/log)"
      if [ -d /var/lib/systemd/coredump ]; then
        local cd; cd=$(find /var/lib/systemd/coredump -type f -size +0 2>/dev/null | wc -l)
        [ "$cd" -gt 0 ] && printf '  %-48s %8d  volcados\n' "/var/lib/systemd/coredump" "$cd"
      fi
      echo
    fi

    # --- TRASH ---
    if [ "$do_trash" -eq 1 ]; then
      printf '  \033[1;33m[ TRASH ]\033[0m Papelera del usuario\n'
      local trash="${XDG_DATA_HOME:-$HOME/.local/share}/Trash"
      if [ -d "$trash/files" ]; then
        local tc; tc=$(find "$trash/files" -type f 2>/dev/null | wc -l)
        printf '  %-48s %8s  %6d archivos\n' "$trash/files" "$(path_size "$trash/files")" "${tc:-0}"
      fi
      echo
    fi

    # --- BROWSERS ---
    if [ "$do_browsers" -eq 1 ]; then
      printf '  \033[1;33m[ BROWSERS ]\033[0m Caché de navegadores\n'
      # Contar rápido
      local cfgd="${XDG_CONFIG_HOME:-$HOME/.config}"
      local bc=0
      for bd in "$cfgd/google-chrome" "$cfgd/chromium" "$cfgd/BraveSoftware/Brave-Browser" "$cfgd/microsoft-edge" "$cfgd/opera" "$cfgd/vivaldi" "$HOME/.mozilla/firefox" "$HOME/.librewolf" "$HOME/.zen"; do
        [ -d "$bd" ] && bc=$((bc + 1))
      done
      [ "$bc" -gt 0 ] && printf '  %-48s %8d  navegadores\n' "detectados" "$bc"
      echo
    fi

    # --- MEDIA ---
    if [ "$do_media" -eq 1 ]; then
      printf '  \033[1;33m[ MEDIA ]\033[0m Cachés multimedia\n'
      local mc=0
      for md in "$cache/vlc" "$cache/mpv" "$cache/gstreamer-1.0" "$cache/gimp" "$cache/krita" "$cache/ffmpeg"; do
        [ -d "$md" ] && { mc=$((mc + 1)); printf '  %-48s %8s\n' "$(echo "$md" | sed "s|$HOME|~|")" "$(path_size "$md")"; }
      done
      [ "$mc" -gt 0 ] || printf '  %-48s %8s\n' "(no se detectaron)" "—"
      echo
    fi

    # --- WINE ---
    if [ "$do_wine" -eq 1 ] && [ -d "$HOME/.wine" ]; then
      printf '  \033[1;33m[ WINE ]\033[0m Basura de Wine\n'
      local uname; uname=$(id -un 2>/dev/null || echo "$USER")
      for wp in "$HOME/.wine/drive_c/users/$uname/Temp" "$HOME/.wine/drive_c/users/$uname/AppData/Local/Temp" "$HOME/.wine/drive_c/windows/temp"; do
        [ -d "$wp" ] && printf '  %-48s %8s\n' "$(echo "$wp" | sed "s|$HOME|~|")" "$(path_size "$wp")"
      done
      echo
    fi

    # --- DEV ---
    if [ "$do_dev" -eq 1 ]; then
      printf '  \033[1;33m[ DEV ]\033[0m Herramientas de desarrollo\n'
      [ -d "$HOME/.gradle/caches" ]    && printf '  %-48s %8s\n' "~/.gradle/caches"    "$(path_size "$HOME/.gradle/caches")"
      [ -d "$HOME/.npm/_cacache" ]     && printf '  %-48s %8s\n' "~/.npm/_cacache"     "$(path_size "$HOME/.npm/_cacache")"
      [ -d "$HOME/.cargo/registry" ]   && printf '  %-48s %8s\n' "~/.cargo/registry"   "$(path_size "$HOME/.cargo/registry")"
      echo
    fi

    # --- JUNK ---
    if [ "$do_junk" -eq 1 ]; then
      printf '  \033[1;33m[ JUNK ]\033[0m Archivos basura\n'
      local jc=0
      jc=$(find /tmp /var/tmp "$HOME/Downloads" -maxdepth 3 -type f \( -name "*.swp" -o -name "*.bak" -o -name "*.old" -o -name "*.part" -o -name "*.crdownload" -o -name "*.tmp" -o -name "*.lock" \) 2>/dev/null | wc -l)
      printf '  %-48s %8d  archivos\n' "basura en /tmp, /var/tmp, ~/Downloads" "${jc:-0}"
      local pc; pc=$(find "$HOME" -maxdepth 6 -path '*/__pycache__' -type d 2>/dev/null | wc -l)
      [ "${pc:-0}" -gt 0 ] && printf '  %-48s %8d  directorios\n' "__pycache__ en ~/" "$pc"
      echo
    fi

    # --- RESUMEN ---
    local total_found=0
    # Aproximación rápida
    for p in /tmp /var/tmp /var/cache "$cache" "$HOME/.local/share/Trash" /var/log; do
      [ -d "$p" ] || continue
      local kb; kb=$(du -sk "$p" 2>/dev/null | awk '{print $1}')
      total_mb=$((total_mb + ${kb:-0} / 1024))
    done

    echo
    printf '  \033[1;36m%s\033[0m\n' "$hr"
    printf '  \033[1;37mTotal aproximado encontrado:\033[0m \033[1;33m%d MB\033[0m\n' "$total_mb"
    printf '  \033[1;36m%s\033[0m\n' "$hr"
    echo

    # --- LISTA DE TAREAS ---
    local task_list=""
    [ "$do_temp"    -eq 1 ] && task_list="$task_list Temp"
    [ "$do_cache"   -eq 1 ] && task_list="$task_list Cache"
    [ "$do_logs"    -eq 1 ] && task_list="$task_list Logs"
    [ "$do_trash"   -eq 1 ] && task_list="$task_list Trash"
    [ "$do_thumbs"  -eq 1 ] && task_list="$task_list Thumbs"
    [ "$do_browsers" -eq 1 ] && task_list="$task_list Browsers"
    [ "$do_ram"     -eq 1 ] && task_list="$task_list RAM"
    [ "$do_drives"  -eq 1 ] && task_list="$task_list Drives"
    [ "$do_user_cache" -eq 1 ] && task_list="$task_list UserCache"
    [ "$do_dev"     -eq 1 ] && task_list="$task_list Dev"
    [ "$do_junk"    -eq 1 ] && task_list="$task_list Junk"
    [ "$do_wine"    -eq 1 ] && task_list="$task_list Wine"
    [ "$do_media"   -eq 1 ] && task_list="$task_list Media"
    c_info "Módulos a ejecutar:${task_list}"

    confirm_action "¿Ejecutar limpieza?"
  fi

  local before after
  before=$(df --output=used / 2>/dev/null | tail -1 || echo 0)

  [ "$do_temp"   -eq 1 ] && clean_temp
  [ "$do_cache"  -eq 1 ] && clean_cache
  [ "$do_logs"   -eq 1 ] && clean_logs
  [ "$do_trash"  -eq 1 ] && clean_trash
  [ "$do_thumbs" -eq 1 ] && clean_thumbs
  [ "$do_browsers" -eq 1 ] && clean_browsers
  [ "$do_ram" -eq 1 ] && clean_ram
  [ "$do_drives" -eq 1 ] && clean_drives
  [ "$do_user_cache" -eq 1 ] && clean_user_cache
  [ "$do_dev" -eq 1 ] && clean_dev
  [ "$do_junk" -eq 1 ] && clean_junk
  [ "$do_wine" -eq 1 ] && clean_wine
  [ "$do_media" -eq 1 ] && clean_media

  after=$(df --output=used / 2>/dev/null | tail -1 || echo 0)
  if [ "$DRY_RUN" -eq 0 ] && [ "$before" -gt "$after" ] 2>/dev/null; then
    local freed=$(( (before - after) / 1024 ))
    c_ok "Espacio liberado en /: ${freed} MB aprox."
  fi

  [ "$do_status" -eq 1 ] && clean_status

  # Registrar en historial solo si fue limpieza real
  if [ "$DRY_RUN" -eq 0 ]; then
    local freed_mb=0
    if [ "$before" -gt "$after" ] 2>/dev/null; then
      freed_mb=$(( (before - after) / 1024 ))
    fi
    log_history "clean: ${freed_mb} MB liberados en / (tareas:${task_list:- varias})"
  fi

  c_ok "Limpieza finalizada."
}

main "$@"
